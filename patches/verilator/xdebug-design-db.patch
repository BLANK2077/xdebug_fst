+// DesignDB fixed-size unpacked array element test
+//
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+module unpacked_array_top (
+    input logic [7:0] data,
+    output logic [7:0] dout[3:1],
+    output logic [3:1] flag
+);
+  always_comb begin
+    for (int index = 1; index <= 3; ++index) begin
+      dout[index] = data;
+      flag[index] = data[index];
+    end
+  end
+endmodule
diff --git a/test_regress/t/validate_trace.c b/test_regress/t/validate_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..1b52300c5546f90cb8631569ea0374cc9f49ab6f
--- /dev/null
+++ b/test_regress/t/validate_trace.c
@@ -0,0 +1,418 @@
+// validate_trace.c - Comprehensive validation of xdd API against expected values
+//
+// Usage: validate_trace <path_to_.so> <test_mode>
+//   test_mode: "simple" | "full" | "uart" | "metadata"
+//
+// Returns 0 on success, 1 on failure with diagnostic output.
+//
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+#include "xdd_api.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <dlfcn.h>
+
+// -- Function pointer typedefs --
+typedef XddDb*   (*fn_init)(void);
+typedef void     (*fn_close)(XddDb*);
+typedef int      (*fn_count)(XddDb*);
+typedef XddSignal (*fn_resolve)(XddDb*, const char*);
+typedef int      (*fn_cntd)(XddDb*, int);
+typedef int      (*fn_cntl)(XddDb*, int);
+typedef void     (*fn_trd)(XddDb*, int, int, int*, const char**, const char**, int*);
+typedef void     (*fn_trl)(XddDb*, int, int, int*, const char**, const char**, int*);
+typedef const char* (*fn_name)(XddDb*, int);
+typedef const char* (*fn_type)(XddDb*, int);
+typedef int      (*fn_width)(XddDb*, int);
+typedef const char* (*fn_file)(XddDb*, int);
+typedef int      (*fn_line)(XddDb*, int);
+
+static void* g_handle = NULL;
+static fn_init   init = NULL;
+static fn_close  close_db = NULL;
+static fn_resolve resolve = NULL;
+static fn_cntd   trace_driver_count = NULL;
+static fn_cntl   trace_load_count = NULL;
+static fn_trd    trace_driver = NULL;
+static fn_trl    trace_load = NULL;
+static fn_name   signal_name = NULL;
+static fn_type   signal_type = NULL;
+static fn_width  signal_width = NULL;
+static fn_file   signal_file = NULL;
+static fn_line   signal_line = NULL;
+static fn_count  signal_count = NULL;
+
+static int failed = 0;
+
+#define CHECK(cond, msg, ...) do { \
+    if (!(cond)) { \
+        fprintf(stderr, "FAIL: " msg "\n", ##__VA_ARGS__); \
+        failed = 1; \
+    } else { \
+        printf("  OK: " msg "\n", ##__VA_ARGS__); \
+    } \
+} while(0)
+
+#define CHECK_EQ(a, b, name) CHECK((a) == (b), "%s: expected %d, got %d", name, (int)(b), (int)(a))
+#define CHECK_STR(str, expected, name) CHECK(str && strcmp(str, expected) == 0, \
+    "%s: expected '%s', got '%s'", name, expected, str ? str : "(null)")
+
+// -- Load .so --
+static int load_so(const char* path) {
+    g_handle = dlopen(path, RTLD_NOW);
+    if (!g_handle) { fprintf(stderr, "dlopen failed: %s\n", dlerror()); return 0; }
+    init                = (fn_init)     dlsym(g_handle, "xdd_init");
+    close_db            = (fn_close)    dlsym(g_handle, "xdd_close");
+    resolve             = (fn_resolve)  dlsym(g_handle, "xdd_resolve");
+    trace_driver_count  = (fn_cntd)     dlsym(g_handle, "xdd_trace_driver_count");
+    trace_load_count    = (fn_cntl)     dlsym(g_handle, "xdd_trace_load_count");
+    trace_driver        = (fn_trd)      dlsym(g_handle, "xdd_trace_driver");
+    trace_load          = (fn_trl)      dlsym(g_handle, "xdd_trace_load");
+    signal_name         = (fn_name)     dlsym(g_handle, "xdd_signal_name");
+    signal_type         = (fn_type)     dlsym(g_handle, "xdd_signal_type");
+    signal_width        = (fn_width)    dlsym(g_handle, "xdd_signal_width");
+    signal_file         = (fn_file)     dlsym(g_handle, "xdd_signal_file");
+    signal_line         = (fn_line)     dlsym(g_handle, "xdd_signal_line");
+    signal_count        = (fn_count)    dlsym(g_handle, "xdd_signal_count");
+    if (!init || !close_db || !resolve || !trace_driver_count
+        || !trace_load_count || !trace_driver || !trace_load
+        || !signal_name || !signal_type || !signal_width || !signal_file
+        || !signal_line || !signal_count) {
+        fprintf(stderr, "DesignDB shared library is missing required symbols\n");
+        return 0;
+    }
+    return 1;
+}
+
+// -- Helper: find driver by source signal name --
+static int has_driver_src(XddDb* db, int sig, const char* src_name) {
+    XddSignal src_sig = resolve(db, src_name);
+    if (src_sig < 0) return 0;
+    int n = trace_driver_count(db, sig);
+    for (int i = 0; i < n; ++i) {
+        int s; const char* k, *f; int l;
+        trace_driver(db, sig, i, &s, &k, &f, &l);
+        if (s == src_sig) return 1;
+    }
+    return 0;
+}
+
+// -- Test: simple design --
+static void test_simple(XddDb* db) {
+    printf("=== test_simple ===\n");
+
+    XddSignal sig = resolve(db, "top.out");
+    CHECK(sig >= 0, "resolve('top.out') succeeded, idx=%d", sig);
+
+    int ndrv = trace_driver_count(db, sig);
+    CHECK(ndrv >= 1, "out has at least 1 driver (got %d)", ndrv);
+
+    // out = a & b, so drivers should include a and b
+    CHECK(has_driver_src(db, sig, "top.a"), "out driver includes 'a'");
+    CHECK(has_driver_src(db, sig, "top.b"), "out driver includes 'b'");
+}
+
+// -- Test: full trace design --
+static void test_full(XddDb* db) {
+    printf("=== test_full ===\n");
+
+    int total = signal_count(db);
+    CHECK(total >= 10, "signal count >= 10 (got %d)", total);
+
+    // Verilator wraps top-level modules: the actual logic assignments
+    // are on the top-level port signals (e.g. "top.out_proc"), not
+    // the flattened module signals ("top.trace_comprehensive.out_proc").
+
+    // Check signal name resolution
+    XddSignal iw = resolve(db, "top.trace_comprehensive.int_wire");
+    CHECK(iw >= 0, "resolve int_wire succeeded");
+
+    // int_wire = a & b (cont_assign) - check on flat name
+    CHECK(has_driver_src(db, iw, "top.a"), "int_wire driver includes 'a'");
+    CHECK(has_driver_src(db, iw, "top.b"), "int_wire driver includes 'b'");
+
+    // out_proc = sel ? a : b (proc_assign) - check on top-level port
+    XddSignal op = resolve(db, "top.out_proc");
+    CHECK(op >= 0, "resolve top.out_proc succeeded");
+    int n = trace_driver_count(db, op);
+    CHECK(n >= 2, "out_proc has >= 2 drivers (got %d)", n);
+    CHECK(has_driver_src(db, op, "top.a"), "out_proc driver includes 'a'");
+    CHECK(has_driver_src(db, op, "top.b"), "out_proc driver includes 'b'");
+    CHECK(has_driver_src(db, op, "top.sel"), "out_proc driver includes 'sel' (control)");
+
+    // out_nba <= int_wire (nba) - check on top-level port
+    XddSignal on = resolve(db, "top.out_nba");
+    CHECK(on >= 0, "resolve top.out_nba succeeded");
+    n = trace_driver_count(db, on);
+    int found_nba = 0;
+    for (int i = 0; i < n; ++i) {
+        int s; const char* k, *f; int l;
+        trace_driver(db, on, i, &s, &k, &f, &l);
+        if (k && strcmp(k, "nba") == 0) found_nba = 1;
+    }
+    CHECK(found_nba, "out_nba has nba driver");
+    CHECK(has_driver_src(db, on, "top.rst_n"), "out_nba driver includes 'rst_n' (control)");
+
+    // out_case driven by case statement
+    XddSignal oc = resolve(db, "top.out_case");
+    CHECK(oc >= 0, "resolve top.out_case succeeded");
+    n = trace_driver_count(db, oc);
+    CHECK(n >= 1, "out_case has >= 1 driver (got %d)", n);
+    CHECK(has_driver_src(db, oc, "top.a"), "out_case driver includes 'a'");
+    CHECK(has_driver_src(db, oc, "top.b"), "out_case driver includes 'b'");
+
+    // Test loads
+    XddSignal a_sig = resolve(db, "top.a");
+    CHECK(a_sig >= 0, "resolve 'a' succeeded");
+    int nld = trace_load_count(db, a_sig);
+    CHECK(nld >= 1, "'a' has at least 1 load (got %d)", nld);
+}
+
+// -- Test: UART design --
+static void test_uart(XddDb* db) {
+    printf("=== test_uart ===\n");
+
+    int total = signal_count(db);
+    CHECK(total >= 200, "signal count >= 200 (got %d)", total);
+
+    // TX related signals should exist
+    XddSignal txd = resolve(db, "top.txd");
+    CHECK(txd >= 0, "resolve top.txd succeeded");
+
+    XddSignal rxd = resolve(db, "top.rxd");
+    CHECK(rxd >= 0, "resolve top.rxd succeeded");
+
+    // RXD should have driver (connected to external pin or loopback)
+    XddSignal uart_rxd = resolve(db, "top.uart_16550.rxd");
+    if (uart_rxd >= 0) {
+        int ndrv = trace_driver_count(db, uart_rxd);
+        CHECK(ndrv >= 1, "uart.rxd has >= 1 driver (got %d)", ndrv);
+        CHECK(has_driver_src(db, uart_rxd, "top.rxd"),
+              "uart.rxd driver includes 'top.rxd'");
+    }
+
+    // UART TX related checks
+    XddSignal uart_txd = resolve(db, "top.uart_16550.txd");
+    if (uart_txd >= 0) {
+        int ndrv = trace_driver_count(db, uart_txd);
+        CHECK(ndrv >= 1, "uart.txd has >= 1 driver (got %d)", ndrv);
+    }
+}
+
+// -- Test: metadata --
+static void test_metadata(XddDb* db) {
+    printf("=== test_metadata ===\n");
+
+    XddSignal sig = resolve(db, "top.trace_comprehensive.int_wire");
+    CHECK(sig >= 0, "resolve int_wire for metadata");
+
+    // Type
+    const char* typ = signal_type(db, sig);
+    CHECK_STR(typ, "wire", "int_wire type");
+
+    // Width
+    int w = signal_width(db, sig);
+    CHECK_EQ(w, 1, "int_wire width");
+
+    // Name
+    const char* nm = signal_name(db, sig);
+    CHECK_STR(nm, "top.trace_comprehensive.int_wire", "int_wire name");
+
+    // File/line (should point to the test file)
+    const char* fl = signal_file(db, sig);
+    CHECK(fl != NULL && strlen(fl) > 0, "int_wire has source file");
+    int ln = signal_line(db, sig);
+    CHECK(ln > 0, "int_wire has source line > 0 (got %d)", ln);
+
+    // Resolution failure
+    XddSignal bad = resolve(db, "nonexistent.signal.name");
+    CHECK_EQ(bad, -1, "resolve nonexistent signal returns -1");
+
+    // Out of range
+    CHECK(trace_driver_count(db, -1) == 0, "driver count for -1 returns 0");
+    CHECK(trace_driver_count(db, 99999) == 0, "driver count for out-of-range returns 0");
+    CHECK(signal_name(db, -1) == NULL, "name for -1 returns NULL");
+    CHECK(signal_width(db, -1) == 0, "width for -1 returns 0");
+}
+
+// -- Test: ops - comprehensive operators + nested modules --
+static void test_ops(XddDb* db) {
+    printf("=== test_ops ===\n");
+
+    // Signal count - should have 64 signals across 6 modules
+    int total = signal_count(db);
+    CHECK(total >= 60, "signal count >= 60 (got %d)", total);
+
+    // -- Module nesting verification --
+    // Level-1 module signals accessible
+    XddSignal leaf_add = resolve(db, "top.top.u_leaf_a.out_add");
+    CHECK(leaf_add >= 0, "resolve leaf_module.out_add");
+    CHECK(has_driver_src(db, leaf_add, "top.a"), "out_add driver includes top-level 'a'");
+    CHECK(has_driver_src(db, leaf_add, "top.b"), "out_add driver includes top-level 'b'");
+
+    // Level-2 module (leaf_nested) signals
+    XddSignal nested_out = resolve(db, "top.top.u_leaf_a.u_leaf_b.out_nested");
+    CHECK(nested_out >= 0, "resolve leaf_nested.out_nested");
+    int ndrv = trace_driver_count(db, nested_out);
+    CHECK(ndrv >= 1, "out_nested has drivers (got %d)", ndrv);
+
+    // Level-3 module (leaf_deep) signals
+    XddSignal deep_out = resolve(db, "top.top.u_leaf_a.u_leaf_b.u_leaf_c.out_d");
+    CHECK(deep_out >= 0, "resolve leaf_deep.out_d (deepest module)");
+
+    // -- Arithmetic operators --
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_add"), "top.a"), "add: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_add"), "top.b"), "add: b");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_sub"), "top.a"), "sub: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_mul"), "top.a"), "mul: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_mul"), "top.b"), "mul: b");
+
+    // -- Bitwise operators --
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_and"), "top.a"), "and: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_and"), "top.b"), "and: b");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_xor"), "top.a"), "xor: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_not"), "top.a"), "not: a");
+
+    // -- Logical operators --
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_land"), "top.a"), "land: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_lor"), "top.a"), "lor: a");
+
+    // -- Comparison operators --
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_eq"), "top.a"), "eq: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_eq"), "top.b"), "eq: b");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_lt"), "top.a"), "lt: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_gt"), "top.a"), "gt: a");
+
+    // -- Shift operators --
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_shl"), "top.a"), "shl: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_shr"), "top.a"), "shr: a");
+
+    // -- Reduction operators --
+    XddSignal red = resolve(db, "top.top.u_leaf_a.out_red_and");
+    CHECK(red >= 0, "resolve out_red_and");
+    CHECK(has_driver_src(db, red, "top.b"), "red_and: bus_in (mapped to top.b)");
+
+    // -- Conditional --
+    XddSignal cond = resolve(db, "top.top.u_leaf_a.out_cond");
+    CHECK(cond >= 0, "resolve out_cond");
+    CHECK(has_driver_src(db, cond, "top.sel"), "cond: sel (control)");
+    CHECK(has_driver_src(db, cond, "top.a"), "cond: a");
+    CHECK(has_driver_src(db, cond, "top.b"), "cond: b");
+
+    // -- Concatenation --
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_cat"), "top.a"), "cat: a");
+    CHECK(has_driver_src(db, resolve(db, "top.top.u_leaf_a.out_cat"), "top.b"), "cat: b");
+
+    // -- Replication --
+    XddSignal rep = resolve(db, "top.top.u_leaf_a.out_rep");
+    CHECK(rep >= 0, "resolve out_rep");
+    CHECK(has_driver_src(db, rep, "top.sel"), "rep: sel");
+
+    // -- Constant handling --
+    // internal = pin_x + LP_OFFSET - LP_OFFSET is a constant (statement-only)
+    XddSignal internal = resolve(db, "top.top.u_leaf_a.u_leaf_b.internal");
+    CHECK(internal >= 0, "resolve leaf_nested.internal");
+    // internal = pin_x + LP_OFFSET: may have drivers from pin_x only
+    // The constant LP_OFFSET may appear as statement-only or not at all
+    CHECK(has_driver_src(db, internal, "top.a"), "internal driven by pin_x (top.a)");
+
+    // out_from_b has all the always_comb drivers including control signals
+    XddSignal out_from_b = resolve(db, "top.top.u_leaf_a.out_from_b");
+    CHECK(out_from_b >= 0, "resolve out_from_b (internal)");
+    CHECK(has_driver_src(db, out_from_b, "top.sel"), "out_from_b driver includes sel (control)");
+    CHECK(has_driver_src(db, out_from_b, "top.a"), "out_from_b driver includes pin_x (top.a)");
+    CHECK(has_driver_src(db, out_from_b, "top.b"), "out_from_b driver includes pin_y (top.b)");
+    CHECK(has_driver_src(db, out_from_b, "top.top.u_leaf_a.u_leaf_b.internal"),
+          "out_from_b driver includes internal");
+    // The LP_OFFSET constant in else branch is constant-folded by Verilator,
+    // so it does NOT produce a statement-only driver - expected behavior.
+
+    // -- Cross-module dataflow --
+    // Verilator flattens: leaf_deep.out_d <-> top.deep_out wire.
+    // top.deep_out is driven by gen_out (from the assign in leaf_deep),
+    // and leaf_deep.out_d port is driven by top.deep_out.
+    XddSignal out_deep = resolve(db, "top.top.u_leaf_a.u_leaf_b.out_deep");
+    CHECK(out_deep >= 0, "resolve out_deep");
+    CHECK(has_driver_src(db, out_deep, "top.top.deep_out"),
+          "out_deep driven by top.deep_out wire");
+
+    XddSignal deep_wire = resolve(db, "top.top.deep_out");
+    CHECK(deep_wire >= 0, "resolve top.deep_out");
+    // gen_out is the source wire in leaf_deep that feeds out_d
+    int has_deep_drv = (has_driver_src(db, deep_wire,
+        "top.top.u_leaf_a.u_leaf_b.u_leaf_c.out_d") ||
+        has_driver_src(db, deep_wire,
+        "top.top.u_leaf_a.u_leaf_b.u_leaf_c.gen_out"));
+    CHECK(has_deep_drv, "top.deep_out has leaf_deep driver (out_d or gen_out)");
+
+    // leaf_deep.out_d port is driven by top.deep_out (port connection direction)
+    XddSignal deep_d = resolve(db, "top.top.u_leaf_a.u_leaf_b.u_leaf_c.out_d");
+    CHECK(deep_d >= 0, "resolve leaf_deep.out_d");
+    int dd_drv = trace_driver_count(db, deep_d);
+    CHECK(dd_drv >= 1, "leaf_deep.out_d has driver (got %d)", dd_drv);
+
+    // combine_module: intermediate = in_a ^ in_b
+    XddSignal inter = resolve(db, "top.top.u_combine.intermediate");
+    CHECK(inter >= 0, "resolve combine_module.intermediate");
+
+    // final_out = sel ? combined_out : deep_out
+    XddSignal final_out = resolve(db, "top.final_out");
+    CHECK(final_out >= 0, "resolve final_out");
+    ndrv = trace_driver_count(db, final_out);
+    CHECK(ndrv >= 2, "final_out has >= 2 drivers (got %d)", ndrv);
+    CHECK(has_driver_src(db, final_out, "top.sel"), "final_out driver includes sel");
+    CHECK(has_driver_src(db, final_out, "top.top.combined_out"),
+          "final_out driver includes combined_out");
+    CHECK(has_driver_src(db, final_out, "top.top.deep_out"),
+          "final_out driver includes deep_out");
+
+    // -- Load checks --
+    XddSignal a_sig = resolve(db, "top.a");
+    CHECK(a_sig >= 0, "resolve 'a'");
+    int nld = trace_load_count(db, a_sig);
+    CHECK(nld >= 5, "'a' has many loads (operator tests, got %d)", nld);
+
+    XddSignal b_sig = resolve(db, "top.b");
+    CHECK(b_sig >= 0, "resolve 'b'");
+    nld = trace_load_count(db, b_sig);
+    CHECK(nld >= 5, "'b' has many loads (got %d)", nld);
+
+    printf("  ops test: all core checks passed\n");
+}
+
+// -- Main --
+int main(int argc, char** argv) {
+    if (argc != 3) {
+        fprintf(stderr, "Usage: %s <path_to_.so> <test_mode>\n", argv[0]);
+        fprintf(stderr, "  test_mode: simple | full | uart | metadata | ops\n");
+        return 1;
+    }
+
+    if (!load_so(argv[1])) return 1;
+
+    XddDb* db = init();
+    if (!db) { fprintf(stderr, "xdd_init failed\n"); return 1; }
+
+    const char* mode = argv[2];
+    if (strcmp(mode, "simple") == 0)   test_simple(db);
+    else if (strcmp(mode, "full") == 0)   test_full(db);
+    else if (strcmp(mode, "uart") == 0)   test_uart(db);
+    else if (strcmp(mode, "metadata") == 0) test_metadata(db);
+    else if (strcmp(mode, "ops") == 0)     test_ops(db);
+    else {
+        fprintf(stderr, "Unknown mode: %s\n", mode);
+        failed = 1;
+    }
+
+    close_db(db);
+    dlclose(g_handle);
+
+    if (failed) {
+        printf("\n=== SOME TESTS FAILED ===\n");
+        return 1;
+    }
+    printf("\n=== ALL TESTS PASSED ===\n");
+    return 0;
+}
