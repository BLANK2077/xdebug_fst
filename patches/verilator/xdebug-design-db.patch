diff --git a/test_regress/t/t_xdd_trace_ops.v b/test_regress/t/t_xdd_trace_ops.v
new file mode 100644
index 0000000000000000000000000000000000000000..1471948d02b067ca1af7e81a444584051f476695
--- /dev/null
+++ b/test_regress/t/t_xdd_trace_ops.v
@@ -0,0 +1,207 @@
+// Comprehensive trace test: operators, generate, bitselect, constants,
+// 3-level module nesting, cross-module dataflow
+//
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+//
+// Hierarchy:
+//   top
+//     u_leaf_a (leaf_module)    - operators
+//       u_leaf_b (leaf_nested)  - constants + control flow
+//         u_leaf_c (leaf_deep)  - generate + bitselect
+//     u_combine (combine_module) - cross-module combine
+
+// =========================================================================
+// Level 3: leaf_deep - generate + bit/part select
+// =========================================================================
+module leaf_deep #(parameter W = 8) (
+  input  wire [W-1:0] pin_d,
+  output wire [W-1:0] out_d
+);
+  wire [W-1:0] gen_out [0:3];
+
+  // if-generate
+  generate
+    if (W == 8) begin : gen_wide
+      assign gen_out[0] = {pin_d[3:0], pin_d[7:4]};  // part select + concat
+    end else begin : gen_narrow
+      assign gen_out[0] = pin_d;
+    end
+  endgenerate
+
+  // for-generate
+  genvar gi;
+  generate
+    for (gi = 1; gi < 4; gi = gi + 1) begin : gen_shift
+      assign gen_out[gi] = gen_out[gi-1] << 1;  // cross-generate dependency
+    end
+  endgenerate
+
+  assign out_d = gen_out[3];
+endmodule
+
+// =========================================================================
+// Level 2: leaf_nested - constants + multi-level control flow
+// =========================================================================
+module leaf_nested #(parameter W = 8) (
+  input  wire [W-1:0] pin_x,
+  input  wire [W-1:0] pin_y,
+  input  wire         pin_en,
+  output reg  [W-1:0] out_nested,
+  output wire [W-1:0] out_deep       // from deep instance
+);
+  localparam LP_OFFSET = 4'h3;
+  wire [W-1:0] internal;
+
+  // Constant on RHS
+  assign internal = pin_x + LP_OFFSET;
+
+  // Multi-level if nesting with bitselect in condition
+  always_comb begin
+    if (pin_en) begin                     // Level 1 control
+      if (pin_x > pin_y) begin            // Level 2 control
+        if (pin_x[W-1])                   // Level 3 control + bit select
+          out_nested = internal;
+        else
+          out_nested = pin_y;
+      end else begin
+        out_nested = pin_x;
+      end
+    end else begin
+      out_nested = LP_OFFSET;             // Pure constant (statement-only driver)
+    end
+  end
+
+  // Deep instance
+  leaf_deep #(.W(W)) u_leaf_c (
+    .pin_d (internal),
+    .out_d (out_deep)
+  );
+endmodule
+
+// =========================================================================
+// Level 1: leaf_module - all operator types
+// =========================================================================
+module leaf_module (
+  input  wire         clk,
+  input  wire [7:0]   pin_a,
+  input  wire [7:0]   pin_b,
+  input  wire         pin_sel,
+  input  wire [2:0]   pin_amt,
+  input  wire [7:0]   bus_in,
+  output wire [7:0]   out_a,
+  output wire [7:0]   out_deep_from_leaf
+);
+  wire [7:0]  out_add, out_sub, out_mul, out_div, out_mod;
+  wire [7:0]  out_and, out_or, out_xor, out_not;
+  wire        out_land, out_lor, out_ln;
+  wire        out_eq, out_neq, out_lt, out_gt, out_le, out_ge;
+  wire [7:0]  out_shl, out_shr;
+  wire        out_red_and, out_red_or, out_red_xor;
+  wire [7:0]  out_cond, out_cat, out_rep;
+
+  // -- Arithmetic --
+  assign out_add = pin_a + pin_b;
+  assign out_sub = pin_a - pin_b;
+  assign out_mul = pin_a * pin_b;
+  assign out_div = pin_b ? (pin_a / pin_b) : 8'h0;
+  assign out_mod = pin_b ? (pin_a % pin_b) : 8'h0;
+
+  // -- Bitwise --
+  assign out_and = pin_a & pin_b;
+  assign out_or  = pin_a | pin_b;
+  assign out_xor = pin_a ^ pin_b;
+  assign out_not = ~pin_a;
+
+  // -- Logical --
+  assign out_land = (pin_a != 0) && (pin_b != 0);
+  assign out_lor  = (pin_a != 0) || (pin_b != 0);
+  assign out_ln   = !pin_a;
+
+  // -- Comparison --
+  assign out_eq  = (pin_a == pin_b);
+  assign out_neq = (pin_a != pin_b);
+  assign out_lt  = (pin_a <  pin_b);
+  assign out_gt  = (pin_a >  pin_b);
+  assign out_le  = (pin_a <= pin_b);
+  assign out_ge  = (pin_a >= pin_b);
+
+  // -- Shift --
+  assign out_shl = pin_a << pin_amt;
+  assign out_shr = pin_a >> pin_amt;
+
+  // -- Reduction --
+  assign out_red_and = &bus_in;
+  assign out_red_or  = |bus_in;
+  assign out_red_xor = ^bus_in;
+
+  // -- Conditional --
+  assign out_cond = pin_sel ? pin_a : pin_b;
+
+  // -- Concatenation --
+  assign out_cat = {pin_a[3:0], pin_b[3:0]};
+  assign out_rep = {4{pin_sel}};
+
+  // -- Combine outputs --
+  assign out_a = out_add;
+
+  // -- Nested instance --
+  leaf_nested #(.W(8)) u_leaf_b (
+    .pin_x      (pin_a),
+    .pin_y      (pin_b),
+    .pin_en     (pin_sel),
+    .out_nested (out_from_b),
+    .out_deep   (out_deep_from_leaf)
+  );
+  wire [7:0] out_from_b;
+endmodule
+
+// =========================================================================
+// combine_module - cross-module signal combination
+// =========================================================================
+module combine_module (
+  input  wire [7:0] in_a,
+  input  wire [7:0] in_b,
+  output wire [7:0] out_z
+);
+  wire [7:0] intermediate;
+
+  assign intermediate = in_a ^ in_b;
+  assign out_z = intermediate + 8'h01;  // Constant operand
+endmodule
+
+// =========================================================================
+// Top level
+// =========================================================================
+module top (
+  input  wire       clk,
+  input  wire [7:0] a,
+  input  wire [7:0] b,
+  input  wire       sel,
+  input  wire [2:0] amt,
+  output wire [7:0] final_out
+);
+  wire [7:0] leaf_a_out;
+  wire [7:0] combined_out;
+  wire [7:0] deep_out;
+
+  leaf_module u_leaf_a (
+    .clk               (clk),
+    .pin_a             (a),
+    .pin_b             (b),
+    .pin_sel           (sel),
+    .pin_amt           (amt),
+    .bus_in            (b),
+    .out_a             (leaf_a_out),
+    .out_deep_from_leaf(deep_out)
+  );
+
+  combine_module u_combine (
+    .in_a  (leaf_a_out),
+    .in_b  (b),
+    .out_z (combined_out)
+  );
+
+  // Final output comes from combined path; deep path available for tracing
+  assign final_out = sel ? combined_out : deep_out;
+endmodule
