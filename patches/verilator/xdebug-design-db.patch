+// DESCRIPTION: Verilator: Test nested wildcard members in matches patterns
+//
+// This file ONLY is placed under the Creative Commons Public Domain.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: CC0-1.0
+
+// verilog_format: off
+`define stop $stop
+`define checkh(gotv,expv) do if ((gotv) !== (expv)) begin $write("%%Error: %s:%0d: got='h%x exp='h%x\n", `__FILE__, `__LINE__, (gotv), (expv)); `stop; end while (0)
+// verilog_format: on
+
+module t;
+  typedef struct packed {
+    logic [1:0] tag;
+    logic [3:0] payload;
+  } packet_t;
+
+  function automatic logic [7:0] decode(input packet_t packet);
+    case (packet) matches
+      '{tag: 2'b01, payload: .*}: decode = 8'h10;
+      '{tag: 2'b10, payload: 4'h5}: decode = 8'h25;
+      default: decode = 8'hff;
+    endcase
+  endfunction
+
+  function automatic logic is_tag_one(input packet_t packet);
+    return packet matches '{tag: 2'b01, payload: .*};
+  endfunction
+
+  packet_t packet;
+  logic [7:0] expected;
+
+  initial begin
+    for (int value = 0; value < 64; ++value) begin
+      packet = packet_t'(value);
+      if (packet.tag == 2'b01) expected = 8'h10;
+      else if (packet == packet_t'(6'h25)) expected = 8'h25;
+      else expected = 8'hff;
+      `checkh(decode(packet), expected);
+      `checkh(is_tag_one(packet), packet.tag == 2'b01);
+    end
+    $write("*-* All Finished *-*\n");
+    $finish;
+  end
+endmodule
