diff --git a/test_regress/t/t_xdd_trace_full.v b/test_regress/t/t_xdd_trace_full.v
new file mode 100644
index 0000000000000000000000000000000000000000..42f31be428ff7c9d8fdff83f28dcdf3a00542eb0
--- /dev/null
+++ b/test_regress/t/t_xdd_trace_full.v
@@ -0,0 +1,56 @@
+// Comprehensive trace test design for xdebug design-db
+// Covers: cont_assign, proc_assign, nba, if/case control deps, parameters
+//
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+module trace_comprehensive (
+  input  wire       clk,
+  input  wire       rst_n,
+  input  wire       a,
+  input  wire       b,
+  input  wire       sel,
+  output wire       out_cont,
+  output reg        out_proc,
+  output reg        out_nba,
+  output reg        out_case
+);
+
+  wire  int_wire;
+  reg   int_reg;
+
+  // 1. Continuous assignment (cont_assign)
+  assign int_wire = a & b;
+  assign out_cont = int_wire;
+
+  // 2. Procedural assignment (proc_assign) with if control
+  always @* begin
+    if (sel) begin
+      out_proc = a;
+    end else begin
+      out_proc = b;
+    end
+  end
+
+  // 3. Non-blocking assignment (nba) with reset control
+  always @(posedge clk or negedge rst_n) begin
+    if (!rst_n) begin
+      out_nba <= 1'b0;
+    end else begin
+      out_nba <= int_wire;
+    end
+  end
+
+  // 4. Case statement (control dependency)
+  always @* begin
+    int_reg = 1'b0;
+    case ({a, b})
+      2'b00: out_case = 1'b0;
+      2'b01: out_case = int_wire;
+      2'b10: out_case = a;
+      2'b11: out_case = b;
+      default: out_case = 1'b1;
+    endcase
+  end
+
+endmodule
