+#!/usr/bin/env python3
+# DESCRIPTION: Verilator: Test DesignDB ABI, declared direction, and port edges
+#
+# SPDX-FileCopyrightText: 2026 Wilson Snyder
+# SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+import ctypes
+import subprocess
+from pathlib import Path
+
+import vltest_bootstrap
+
+test.scenarios("vlt")
+
+test.compile(
+    top_filename="t/t_xdd_p3.v",
+    v_flags=["--design-db", "--top-module", "p3_sem_top"],
+    make_main=False,
+    make_top_shell=False,
+    verilator_make_gmake=False,
+)
+
+database = Path(test.obj_dir).resolve() / f"{test.vm_prefix}__DesignDb.cpp"
+assert database.exists(), f"DesignDb file not generated: {database}"
+contents = database.read_text(encoding="utf-8")
+
+assert "int xdd_abi_version(void)" in contents
+assert "uint64_t xdd_capabilities(void)" in contents
+assert "int xdd_signal_direction(XddDb*, int idx)" in contents
+assert "int xdd_port_connection_count(XddDb*, int idx)" in contents
+assert "void xdd_port_connection(XddDb*, int idx, int i," in contents
+assert "const char* xdd_trace_driver_role(XddDb*, int idx, int i)" in contents
+assert "const char* xdd_trace_driver_predicate(XddDb*, int idx, int i)" in contents
+
+# The generated table records the top-to-mid and mid-to-leaf port boundaries.
+assert '"port_boundary"' in contents
+assert "kPortConnectionCount" in contents
+
+root = Path(test.root).resolve()
+shared_db = Path(test.obj_dir).resolve() / f"lib{test.vm_prefix}__DesignDb.so"
+subprocess.run(
+    [
+        "g++", "-std=c++17", "-Wall", "-Wextra", "-Werror",
+        "-shared", "-fPIC", f"-I{root / 'include'}",
+        "-o", str(shared_db), str(database),
+    ],
+    check=True,
+    cwd=root,
+)
+
+db_lib = ctypes.CDLL(str(shared_db))
+db_lib.xdd_abi_version.restype = ctypes.c_int
+db_lib.xdd_capabilities.restype = ctypes.c_uint64
+assert db_lib.xdd_abi_version() == 2
+assert db_lib.xdd_capabilities() == 15
+
+db_lib.xdd_init.restype = ctypes.c_void_p
+db = db_lib.xdd_init()
+assert db
+db_lib.xdd_signal_count.argtypes = [ctypes.c_void_p]
+db_lib.xdd_signal_count.restype = ctypes.c_int
+assert db_lib.xdd_signal_count(db) > 0  # Version-1 API remains callable.
+
+db_lib.xdd_resolve.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
+db_lib.xdd_resolve.restype = ctypes.c_int
+db_lib.xdd_signal_direction.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_signal_direction.restype = ctypes.c_int
+db_lib.xdd_port_connection_count.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_port_connection_count.restype = ctypes.c_int
+db_lib.xdd_port_connection.argtypes = [
+    ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
+    ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_char_p),
+]
+db_lib.xdd_trace_driver_count.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_trace_driver_count.restype = ctypes.c_int
+db_lib.xdd_trace_driver.argtypes = [
+    ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
+    ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int),
+]
+db_lib.xdd_trace_driver_role.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+db_lib.xdd_trace_driver_role.restype = ctypes.c_char_p
+db_lib.xdd_trace_driver_predicate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+db_lib.xdd_trace_driver_predicate.restype = ctypes.c_char_p
+
+clk = db_lib.xdd_resolve(db, b"top.p3_sem_top.u_mid.clk")
+out = db_lib.xdd_resolve(db, b"top.p3_sem_top.u_mid.out")
+assert clk >= 0 and out >= 0
+assert db_lib.xdd_signal_direction(db, clk) == 1
+assert db_lib.xdd_signal_direction(db, out) == 2
+assert db_lib.xdd_port_connection_count(db, clk) == 1
+connected = ctypes.c_int(-1)
+kind = ctypes.c_char_p()
+db_lib.xdd_port_connection(db, clk, 0, ctypes.byref(connected), ctypes.byref(kind))
+assert connected.value == db_lib.xdd_resolve(db, b"top.p3_sem_top.clk")
+assert kind.value == b"port_boundary"
+
+# One assignment may depend on both RHS data and an enclosing control.  Those
+# roles are semantically different for active-driver analysis and must not be
+# inferred from source names or source locations by the consumer.
+leaf_out = db_lib.xdd_resolve(db, b"top.p3_sem_top.out")
+assert leaf_out >= 0
+roles = set()
+for i in range(db_lib.xdd_trace_driver_count(db, leaf_out)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, leaf_out, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    if src.value >= 0:
+        roles.add(db_lib.xdd_trace_driver_role(db, leaf_out, i))
+assert roles == {b"rhs", b"control"}
+
+# Driver records from mutually exclusive procedural branches need an explicit,
+# normalized predicate.  A consumer cannot reconstruct reset/non-reset polarity
+# from the existing source-signal, role, and source-line fields.
+leaf_count = db_lib.xdd_resolve(db, b"top.p3_sem_top.count")
+assert leaf_count >= 0
+predicates_by_line = {}
+for i in range(db_lib.xdd_trace_driver_count(db, leaf_count)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, leaf_count, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    predicate = db_lib.xdd_trace_driver_predicate(db, leaf_count, i)
+    assert predicate is not None
+    predicates_by_line.setdefault(line.value, set()).add(predicate.decode("utf-8"))
+
+assert {75, 80, 82, 84}.issubset(predicates_by_line)
+assert len(predicates_by_line[75]) == 1
+assert len(predicates_by_line[80]) == 1
+assert len(predicates_by_line[82]) == 1
+assert len(predicates_by_line[84]) == 1
+reset_predicate = next(iter(predicates_by_line[75]))
+increment_predicate = next(iter(predicates_by_line[80]))
+decrement_predicate = next(iter(predicates_by_line[82]))
+hold_predicate = next(iter(predicates_by_line[84]))
+assert "top.p3_sem_top.rst_n" in reset_predicate
+assert reset_predicate == "!(top.p3_sem_top.rst_n)"
+for predicate in (increment_predicate, decrement_predicate, hold_predicate):
+    assert "top.p3_sem_top.rst_n" in predicate
+    assert "top.p3_sem_top.inc" in predicate
+    assert "top.p3_sem_top.dec" in predicate
+assert len({increment_predicate, decrement_predicate, hold_predicate}) == 3
+
+# Wildcard case matching is a static design fact.  The predicate must preserve
+# whether casez or casex matching applies; publishing no predicate would force
+# a consumer to guess from FST values, while using === would be incorrect.
+def predicates_for(signal_name):
+    signal = db_lib.xdd_resolve(db, signal_name)
+    assert signal >= 0
+    result = {}
+    for i in range(db_lib.xdd_trace_driver_count(db, signal)):
+        src = ctypes.c_int(-1)
+        drv_kind = ctypes.c_char_p()
+        file_name = ctypes.c_char_p()
+        line = ctypes.c_int(0)
+        db_lib.xdd_trace_driver(
+            db, signal, i, ctypes.byref(src), ctypes.byref(drv_kind),
+            ctypes.byref(file_name), ctypes.byref(line),
+        )
+        predicate = db_lib.xdd_trace_driver_predicate(db, signal, i)
+        assert predicate is not None
+        result.setdefault(line.value, set()).add(predicate.decode("utf-8"))
+    return result
+
+casez_predicates = predicates_for(b"top.p3_sem_top.casez_out")
+casex_predicates = predicates_for(b"top.p3_sem_top.casex_out")
+assert any("==?z" in predicate for values in casez_predicates.values()
+           for predicate in values)
+assert any("==?x" in predicate for values in casex_predicates.values()
+           for predicate in values)
+
+# V3Tristate removes equally strong non-tristate net drivers after resolving
+# ordinary simulation behavior.  DesignDB must retain both source statements
+# as static debug facts without keeping either AST assignment alive.
+multiple_driver = db_lib.xdd_resolve(db, b"top.p3_sem_top.multiple_driver_out")
+assert multiple_driver >= 0
+multiple_lines = set()
+multiple_sources = set()
+for i in range(db_lib.xdd_trace_driver_count(db, multiple_driver)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, multiple_driver, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    if line.value in {166, 167}:
+        multiple_lines.add(line.value)
+        multiple_sources.add(src.value)
+        assert drv_kind.value == b"cont_assign"
+        assert db_lib.xdd_trace_driver_role(db, multiple_driver, i) == b"rhs"
+        assert db_lib.xdd_trace_driver_predicate(db, multiple_driver, i) == b"1"
+assert multiple_lines == {166, 167}
+assert multiple_sources == {
+    db_lib.xdd_resolve(db, b"top.p3_sem_top.a"),
+    db_lib.xdd_resolve(db, b"top.p3_sem_top.b"),
+}
+
+# case inside keeps wildcard bits only on the item side and expands an
+# InsideRange to an inclusive lower/upper bound predicate.  Default negates
+# both prior item predicates through the same existing string ABI.
+inside_out = db_lib.xdd_resolve(db, b"top.p3_sem_top.inside_out")
+assert inside_out >= 0
+inside_predicates = {}
+for i in range(db_lib.xdd_trace_driver_count(db, inside_out)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, inside_out, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    predicate = db_lib.xdd_trace_driver_predicate(db, inside_out, i)
+    if line.value in {172, 173, 174}:
+        assert predicate
+        inside_predicates.setdefault(line.value, set()).add(predicate.decode())
+assert any("==?i" in predicate for predicate in inside_predicates[172])
+assert any(">=" in predicate and "<=" in predicate
+           for predicate in inside_predicates[173])
+assert any("==?i" in predicate and ">=" in predicate and "<=" in predicate
+           for predicate in inside_predicates[174])
+
+# An always-driven net connected to an inout port is lowered through internal
+# strength signals.  DesignDB must retain the original HDL RHS relation.
+inout_bus = db_lib.xdd_resolve(db, b"top.p3_sem_top.inout_bus")
+assert inout_bus >= 0
+inout_source_lines = set()
+for i in range(db_lib.xdd_trace_driver_count(db, inout_bus)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, inout_bus, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    if src.value == db_lib.xdd_resolve(db, b"top.p3_sem_top.a"):
+        inout_source_lines.add(line.value)
+        assert drv_kind.value == b"cont_assign"
+        assert db_lib.xdd_trace_driver_role(db, inout_bus, i) == b"rhs"
+assert inout_source_lines == {179}
+
+# Exact expression items in case matches are ordinary static comparisons, not
+# tagged-union patterns.  DesignDB must publish case-equality predicates so the
+# consumer can evaluate the current FST selector without guessing from values.
+matches_out = db_lib.xdd_resolve(db, b"top.p3_sem_top.matches_out")
+assert matches_out >= 0
+matches_predicates = {}
+for i in range(db_lib.xdd_trace_driver_count(db, matches_out)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, matches_out, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    predicate = db_lib.xdd_trace_driver_predicate(db, matches_out, i)
+    if line.value in {185, 186, 187}:
+        assert predicate
+        matches_predicates.setdefault(line.value, set()).add(predicate.decode())
+assert any("===" in predicate for predicate in matches_predicates[185])
+assert any("===" in predicate for predicate in matches_predicates[186])
+assert any("===" in predicate for predicate in matches_predicates[187])
+assert all("==?" not in predicate for values in matches_predicates.values()
+           for predicate in values)
+
+# Assignment execution is an event fact, not a value-change fact.  An NBA may
+# execute with the same value and therefore leave no new FST transition.  Each
+# clocked statement must publish its enclosing sensitivity sources and edges so
+# xdebug can recover the latest assignment opportunity from the raw FST clock.
+temporal_q = db_lib.xdd_resolve(db, b"top.p3_sem_top.temporal_q")
+assert temporal_q >= 0
+temporal_events = set()
+for i in range(db_lib.xdd_trace_driver_count(db, temporal_q)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, temporal_q, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    role = db_lib.xdd_trace_driver_role(db, temporal_q, i)
+    if role and role.startswith(b"event_"):
+        temporal_events.add((src.value, role))
+        assert drv_kind.value == b"nba"
+assert temporal_events == {
+    (db_lib.xdd_resolve(db, b"top.p3_sem_top.clk"), b"event_posedge"),
+}
+
+# A multi-item sensitivity list must preserve every event independently.  It
+# is not valid to pick one arbitrary clock or to hide asynchronous reset behind
+# the branch predicate.
+count_events = set()
+for i in range(db_lib.xdd_trace_driver_count(db, leaf_count)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, leaf_count, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    role = db_lib.xdd_trace_driver_role(db, leaf_count, i)
+    if role and role.startswith(b"event_"):
+        count_events.add((src.value, role))
+assert count_events == {
+    (db_lib.xdd_resolve(db, b"top.p3_sem_top.clk"), b"event_posedge"),
+    (db_lib.xdd_resolve(db, b"top.p3_sem_top.rst_n"), b"event_negedge"),
+}
+
+# Force is an active-driver termination kind in the frozen xdebug contract.
+# Publishing it as an ordinary procedural assignment would make the consumer
+# incorrectly continue through its RHS instead of stopping at the force.
+force_target = db_lib.xdd_resolve(db, b"top.p3_sem_top.force_target")
+assert force_target >= 0
+force_records = []
+for i in range(db_lib.xdd_trace_driver_count(db, force_target)):
+    src = ctypes.c_int(-1)
+    drv_kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, force_target, i, ctypes.byref(src), ctypes.byref(drv_kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    role = db_lib.xdd_trace_driver_role(db, force_target, i)
+    if role == b"rhs":
+        force_records.append((src.value, drv_kind.value))
+assert force_records == [
+    (db_lib.xdd_resolve(db, b"top.p3_sem_top.a"), b"force"),
+]
+
+db_lib.xdd_close.argtypes = [ctypes.c_void_p]
+db_lib.xdd_close(db)
+
+test.passes()
diff --git a/test_regress/t/t_xdd_self_rhs.py b/test_regress/t/t_xdd_self_rhs.py
