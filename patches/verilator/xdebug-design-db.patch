+// DESCRIPTION: Verilator: Test DesignDB matches pattern-variable binding
+//
+// This file ONLY is placed under the Creative Commons Public Domain.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: CC0-1.0
+
+module pattern_binding_top (
+  input  logic [1:0] tag,
+  input  logic [3:0] payload,
+  input  logic [7:0] data,
+  output wire [7:0] out
+);
+  typedef struct packed {
+    logic [1:0] tag;
+    logic [3:0] payload;
+  } packet_t;
+
+  packet_t packet;
+  logic [7:0] bound_out;
+  assign packet = {tag, payload};
+  assign out = bound_out;
+
+  always_comb begin
+    case (packet) matches
+      '{tag: 2'b01, payload:.bound_payload} : bound_out = {data[7:4], bound_payload};
+      '{tag: 2'b10, payload:.bound_payload} : bound_out = {bound_payload, data[3:0]};
+      default: bound_out = 8'h5a;
+    endcase
+  end
+endmodule
