+// DESCRIPTION: Verilator: Test unbound matches operator operands
+//
+// This file ONLY is placed under the Creative Commons Public Domain.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: CC0-1.0
+
+module t;
+  typedef struct packed {
+    logic [1:0] tag;
+    logic [3:0] payload;
+  } packet_t;
+
+  packet_t packet;
+  int calls;
+
+  function automatic logic [1:0] wildcard_value();
+    calls++;
+    return 2'bxz;
+  endfunction
+
+  initial begin
+    packet = packet_t'(6'h1a);
+    calls = 0;
+    if (!(2'b01 matches 2'b01)) $stop;
+    if (2'b01 matches 2'b10) $stop;
+    if (!(2'bxz matches .*)) $stop;
+    if (!(wildcard_value() matches .*)) $stop;
+    if (calls != 1) $stop;
+    if (!(packet matches '{tag: 2'b01, payload: 4'ha})) $stop;
+    if (packet matches '{2'b10, 4'h5}) $stop;
+    $write("*-* All Finished *-*\n");
+    $finish;
+  end
+endmodule
