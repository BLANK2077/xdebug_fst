+// DESCRIPTION: Verilator: Test packed matches pattern variable binding
+//
+// This file ONLY is placed under the Creative Commons Public Domain.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: CC0-1.0
+
+// verilog_format: off
+`define stop $stop
+`define checkh(gotv,expv) do if ((gotv) !== (expv)) begin $write("%%Error: %s:%0d: got='h%x exp='h%x\n", `__FILE__, `__LINE__, (gotv), (expv)); `stop; end while (0)
+// verilog_format: on
+
+module t;
+  typedef struct packed {
+    logic [1:0] tag;
+    logic [3:0] payload;
+  } packet_t;
+
+  packet_t packet;
+  int selector_calls;
+
+  function automatic packet_t side_effect_selector();
+    ++selector_calls;
+    return packet;
+  endfunction
+
+  function automatic logic [7:0] decode(input packet_t packet);
+    case (packet) matches
+      '{tag: 2'b01, payload:.bound_payload} : decode = {4'h1, bound_payload};
+      '{tag: 2'b10, payload:.bound_payload} : decode = {4'h2, bound_payload};
+      default: decode = 8'hff;
+    endcase
+  endfunction
+
+  function automatic logic [5:0] bind_all_members(input packet_t packet);
+    case (packet) matches
+      '{tag:.bound_tag, payload:.bound_payload} :
+        bind_all_members = {bound_tag, bound_payload};
+      default: bind_all_members = 'x;
+    endcase
+  endfunction
+
+  function automatic logic [7:0] binding_scope(input packet_t packet);
+    logic [3:0] bound_payload;
+    logic [3:0] matched_payload;
+    bound_payload = 4'ha;
+    matched_payload = 4'hf;
+    case (packet) matches
+      '{tag: 2'b01, payload:.bound_payload} : matched_payload = bound_payload;
+      default: ;
+    endcase
+    binding_scope = {bound_payload, matched_payload};
+  endfunction
+
+  function automatic logic [7:0] decode_side_effect_selector();
+    /* verilator lint_off SIDEEFFECT */
+    case (side_effect_selector()) matches
+      '{tag: 2'b01, payload:.bound_payload} :
+        decode_side_effect_selector = {4'h1, bound_payload};
+      '{tag: 2'b10, payload:.bound_payload} :
+        decode_side_effect_selector = {4'h2, bound_payload};
+      default: decode_side_effect_selector = 8'hff;
+    endcase
+    /* verilator lint_on SIDEEFFECT */
+  endfunction
+
+  logic [7:0] expected;
+
+  initial begin
+    for (int value = 0; value < 64; ++value) begin
+      packet = packet_t'(value);
+      case (packet.tag)
+        2'b01: expected = {4'h1, packet.payload};
+        2'b10: expected = {4'h2, packet.payload};
+        default: expected = 8'hff;
+      endcase
+      `checkh(decode(packet), expected);
+      `checkh(bind_all_members(packet), packet);
+      `checkh(binding_scope(packet),
+              {4'ha, packet.tag == 2'b01 ? packet.payload : 4'hf});
+      selector_calls = 0;
+      `checkh(decode_side_effect_selector(), expected);
+      `checkh(selector_calls, 1);
+    end
+    $write("*-* All Finished *-*\n");
+    $finish;
+  end
+endmodule
