index 0000000000000000000000000000000000000000..09a258a842ea402df17031df3b1277e5722e0a91
--- /dev/null
+++ b/test_regress/t/t_xdd_unpacked_array.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+# DESCRIPTION: Verilator: Test DesignDB fixed-size unpacked array elements
+#
+# SPDX-FileCopyrightText: 2026 Wilson Snyder
+# SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+import ctypes
+import subprocess
+from pathlib import Path
+
+import vltest_bootstrap
+
+test.scenarios("vlt")
+
+test.compile(
+    top_filename="t/t_xdd_unpacked_array.v",
+    v_flags=["--design-db", "--top-module", "unpacked_array_top"],
+    make_main=False,
+    make_top_shell=False,
+    verilator_make_gmake=False,
+)
+
+root = Path(test.root).resolve()
+database = Path(test.obj_dir).resolve() / f"{test.vm_prefix}__DesignDb.cpp"
+shared_db = Path(test.obj_dir).resolve() / f"lib{test.vm_prefix}__DesignDb.so"
+subprocess.run(
+    [
+        "g++",
+        "-std=c++17",
+        "-Wall",
+        "-Wextra",
+        "-Werror",
+        "-shared",
+        "-fPIC",
+        f"-I{root / 'include'}",
+        "-o",
+        str(shared_db),
+        str(database),
+    ],
+    check=True,
+    cwd=root,
+)
+
+db_lib = ctypes.CDLL(str(shared_db))
+db_lib.xdd_init.restype = ctypes.c_void_p
+db_lib.xdd_resolve.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
+db_lib.xdd_resolve.restype = ctypes.c_int
+db_lib.xdd_signal_width.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_signal_width.restype = ctypes.c_int
+db_lib.xdd_signal_name.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_signal_name.restype = ctypes.c_char_p
+db_lib.xdd_trace_driver_count.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_trace_driver_count.restype = ctypes.c_int
+db_lib.xdd_trace_driver.argtypes = [
+    ctypes.c_void_p,
+    ctypes.c_int,
+    ctypes.c_int,
+    ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+db_lib.xdd_trace_driver.restype = None
+db_lib.xdd_trace_driver_role.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+db_lib.xdd_trace_driver_role.restype = ctypes.c_char_p
+db_lib.xdd_close.argtypes = [ctypes.c_void_p]
+
+
+def driver_records(signal):
+    records = []
+    for offset in range(db_lib.xdd_trace_driver_count(db, signal)):
+        source = ctypes.c_int(-1)
+        kind = ctypes.c_char_p()
+        filename = ctypes.c_char_p()
+        line = ctypes.c_int(0)
+        db_lib.xdd_trace_driver(db, signal, offset, ctypes.byref(source), ctypes.byref(kind),
+                                ctypes.byref(filename), ctypes.byref(line))
+        role = db_lib.xdd_trace_driver_role(db, signal, offset)
+        source_name = db_lib.xdd_signal_name(db, source.value) if source.value >= 0 else None
+        records.append((source_name, kind.value, role, filename.value, line.value))
+    return records
+
+
+db = db_lib.xdd_init()
+assert db
+base = db_lib.xdd_resolve(db, b"top.dout")
+assert base >= 0
+base_drivers = driver_records(base)
+assert base_drivers
+assert any(source and source.endswith(b"data") and role == b"rhs" and line == 13
+           for source, _, role, _, line in base_drivers)
+assert any(source and source.endswith(b"unnamedblk1.index")
+           and role == b"target_loop_index" and line == 13
+           for source, _, role, _, line in base_drivers)
+for element in (1, 2, 3):
+    signal = db_lib.xdd_resolve(db, f"top.dout[{element}]".encode())
+    assert signal >= 0
+    assert db_lib.xdd_signal_width(db, signal) == 8
+    assert driver_records(signal) == base_drivers
+flag = db_lib.xdd_resolve(db, b"top.flag")
+assert flag >= 0
+flag_drivers = driver_records(flag)
+assert any(source and source.endswith(b"unnamedblk1.index")
+           and role == b"target_loop_index" and line == 14
+           for source, _, role, _, line in flag_drivers)
+assert any(source and source.endswith(b"data")
+           and role == b"rhs_loop_selected" and line == 14
+           for source, _, role, _, line in flag_drivers)
+assert any(source and source.endswith(b"unnamedblk1.index")
+           and role == b"rhs_loop_index" and line == 14
+           for source, _, role, _, line in flag_drivers)
+index = db_lib.xdd_resolve(db, b"top.unpacked_array_top.unnamedblk1.index")
+assert index >= 0
+assert all(line not in (13, 14) for _, _, _, _, line in driver_records(index))
+db_lib.xdd_close(db)
+
+test.passes()
diff --git a/test_regress/t/t_xdd_unpacked_array.v b/test_regress/t/t_xdd_unpacked_array.v
