+// DESCRIPTION: Verilator: Test DesignDB nested wildcard matches predicates
+//
+// This file ONLY is placed under the Creative Commons Public Domain.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: CC0-1.0
+
+module nested_matches_top (
+  input  logic [1:0] tag,
+  input  logic [3:0] payload,
+  input  logic [7:0] data,
+  output wire [7:0] out
+);
+  typedef struct packed {
+    logic [1:0] tag;
+    logic [3:0] payload;
+  } packet_t;
+
+  packet_t packet;
+  logic [7:0] nested_out;
+  assign packet = {tag, payload};
+  assign out = nested_out;
+
+  always_comb begin
+    case (packet) matches
+      '{tag: 2'b01, payload: .*}: nested_out = data;
+      default: nested_out = 8'h5a;
+    endcase
+  end
+endmodule
diff --git a/test_regress/t/t_xdd_matches_pattern_binding.py b/test_regress/t/t_xdd_matches_pattern_binding.py
