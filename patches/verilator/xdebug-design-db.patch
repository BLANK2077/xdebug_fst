index 0000000000000000000000000000000000000000..eb714cfd60d62185f94a4af136f032db9abe908e
--- /dev/null
+++ b/test_regress/t/t_xdd_matches_pattern_binding.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+# DESCRIPTION: Verilator: Test DesignDB matches pattern-variable binding
+#
+# SPDX-FileCopyrightText: 2026 Wilson Snyder
+# SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+import ctypes
+import subprocess
+from pathlib import Path
+
+import vltest_bootstrap
+
+test.scenarios("vlt")
+
+test.compile(
+    top_filename="t/t_xdd_matches_pattern_binding.v",
+    v_flags=["--design-db", "--top-module", "pattern_binding_top"],
+    make_main=False,
+    make_top_shell=False,
+    verilator_make_gmake=False,
+)
+
+root = Path(test.root).resolve()
+database = Path(test.obj_dir).resolve() / f"{test.vm_prefix}__DesignDb.cpp"
+assert database.exists(), f"DesignDb file not generated: {database}"
+shared_db = Path(test.obj_dir).resolve() / f"lib{test.vm_prefix}__DesignDb.so"
+subprocess.run(
+    [
+        "g++", "-std=c++17", "-Wall", "-Wextra", "-Werror", "-shared", "-fPIC",
+        f"-I{root / 'include'}", "-o", str(shared_db), str(database),
+    ],
+    check=True,
+    cwd=root,
+)
+
+db_lib = ctypes.CDLL(str(shared_db))
+db_lib.xdd_init.restype = ctypes.c_void_p
+db = db_lib.xdd_init()
+assert db
+db_lib.xdd_resolve.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
+db_lib.xdd_resolve.restype = ctypes.c_int
+db_lib.xdd_trace_driver_count.argtypes = [ctypes.c_void_p, ctypes.c_int]
+db_lib.xdd_trace_driver_count.restype = ctypes.c_int
+db_lib.xdd_trace_driver.argtypes = [
+    ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_int),
+    ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_char_p),
+    ctypes.POINTER(ctypes.c_int),
+]
+db_lib.xdd_trace_driver_role.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+db_lib.xdd_trace_driver_role.restype = ctypes.c_char_p
+db_lib.xdd_trace_driver_predicate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
+db_lib.xdd_trace_driver_predicate.restype = ctypes.c_char_p
+
+out = db_lib.xdd_resolve(db, b"top.pattern_binding_top.bound_out")
+payload = db_lib.xdd_resolve(db, b"top.payload")
+data = db_lib.xdd_resolve(db, b"top.data")
+assert out >= 0 and payload >= 0 and data >= 0
+
+first_match = (
+    b"(((top.pattern_binding_top.packet) & (6'h30)) === "
+    b"((6'h10) & (6'h30)))"
+)
+second_match = (
+    b"(((top.pattern_binding_top.packet) & (6'h30)) === "
+    b"((6'h20) & (6'h30)))"
+)
+
+predicates = set()
+first_rhs = set()
+for index in range(db_lib.xdd_trace_driver_count(db, out)):
+    source = ctypes.c_int(-1)
+    kind = ctypes.c_char_p()
+    file_name = ctypes.c_char_p()
+    line = ctypes.c_int(0)
+    db_lib.xdd_trace_driver(
+        db, out, index, ctypes.byref(source), ctypes.byref(kind),
+        ctypes.byref(file_name), ctypes.byref(line),
+    )
+    role = db_lib.xdd_trace_driver_role(db, out, index)
+    predicate = db_lib.xdd_trace_driver_predicate(db, out, index)
+    assert predicate
+    predicates.add(predicate)
+    if predicate == first_match and role == b"rhs" and source.value >= 0:
+        first_rhs.add(source.value)
+
+expected_predicates = {
+    first_match,
+    second_match,
+    b"!(" + first_match + b" || " + second_match + b")",
+}
+assert predicates == expected_predicates, predicates
+assert first_rhs
+
+
+def rhs_sources(signal):
+    result = set()
+    for index in range(db_lib.xdd_trace_driver_count(db, signal)):
+        if db_lib.xdd_trace_driver_role(db, signal, index) != b"rhs":
+            continue
+        source = ctypes.c_int(-1)
+        kind = ctypes.c_char_p()
+        file_name = ctypes.c_char_p()
+        line = ctypes.c_int(0)
+        db_lib.xdd_trace_driver(
+            db, signal, index, ctypes.byref(source), ctypes.byref(kind),
+            ctypes.byref(file_name), ctypes.byref(line),
+        )
+        if source.value >= 0:
+            result.add(source.value)
+    return result
+
+
+reachable = set(first_rhs)
+frontier = set(first_rhs)
+for _ in range(8):
+    next_frontier = set()
+    for signal in frontier:
+        next_frontier.update(rhs_sources(signal))
+    next_frontier -= reachable
+    if not next_frontier:
+        break
+    reachable.update(next_frontier)
+    frontier = next_frontier
+
+assert data in reachable
+assert payload in reachable
+
+test.passes()
