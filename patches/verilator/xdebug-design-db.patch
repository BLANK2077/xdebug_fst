--- /dev/null
+++ b/test_regress/t/t_xdd_trace.v
@@ -0,0 +1,45 @@
+// DESCRIPTION: Verilator: xdebug design-db trace driver/load test
+//
+// This program is free software; you can redistribute it and/or modify it
+// under the terms of either the GNU Lesser General Public License Version 3
+// or the Perl Artistic License Version 2.0.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+module top (
+  input  logic       clk,
+  input  logic       rst_n,
+  input  logic       a,
+  input  logic       b,
+  input  logic       sel,
+  output logic       out,
+  output logic       out2
+);
+  logic int_sig;
+  logic cond_sig;
+
+  // Continuous assignment (cont_assign)
+  assign int_sig = a & b;
+
+  // Procedural assignment (proc_assign) with control dependency
+  always_comb begin
+    if (sel) begin
+      out = int_sig;  // Driver: int_sig -> out, Control: sel
+    end else begin
+      out = b;         // Driver: b -> out
+    end
+  end
+
+  // Sequential non-blocking (nba)
+  always_ff @(posedge clk or negedge rst_n) begin
+    if (!rst_n) begin
+      out2 <= 1'b0;
+    end else begin
+      out2 <= int_sig;  // Driver: int_sig -> out2, Control: rst_n
+    end
+  end
+
+  // Wire driven by another wire
+  assign cond_sig = a ^ b;
+
+endmodule
