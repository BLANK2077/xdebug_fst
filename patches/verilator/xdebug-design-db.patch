+// Public entry point
+
+void V3EmitDesignDb::emit(AstNetlist* nodep) {
+    UINFO(2, "emitDesignDb: collecting design data\n");
+
+    std::vector<SignalInfo> signals;
+    std::map<const AstVarScope*, int> scopeMap;
+    std::vector<UnpackedElementInfo> unpackedElements;
+    collectSignals(nodep, signals, scopeMap, unpackedElements);
+
+    std::vector<DriverInfo> drivers;
+    std::vector<LoadInfo> loads;
+    collectDriversAndLoads(nodep, scopeMap, drivers, loads);
+    appendUnpackedElementRelationships(unpackedElements, drivers, loads);
+    appendPreservedNetDrivers(signals, drivers, loads);
+    std::vector<PortConnectionInfo> connections = collectPortConnections(signals, drivers);
+    std::vector<std::pair<int, int>> memberIndices;
+    appendInterfaceMemberSignals(signals, connections, memberIndices);
+    appendInterfaceMemberDrivers(signals, memberIndices, drivers, loads);
+    preservedInterfaceMembers().clear();
+
+    UINFO(2, "emitDesignDb: " << signals.size() << " signals, "
+          << drivers.size() << " drivers, " << loads.size() << " loads\n");
+
+    if (v3Global.opt.designDbBinary()) {
+        emitBinary(signals, drivers, loads, connections);
+    } else {
+        emitCpp(signals, drivers, loads, connections);
+    }
+}
+
+void V3EmitDesignDb::captureInterfacePortMembers(AstNetlist* nodep) {
+    preservedInterfaceMembers().clear();
+    std::set<std::pair<std::string, std::string>> seen;
+    nodep->foreach([&](AstNode* childp) {
+        const AstAliasScope* const aliasp = VN_CAST(childp, AliasScope);
+        if (!aliasp) return;
+        const AstVarRef* const lhsRefp = VN_CAST(aliasp->lhsp(), VarRef);
+        const AstVarRef* const rhsRefp = VN_CAST(aliasp->rhsp(), VarRef);
+        if (!lhsRefp || !rhsRefp || !lhsRefp->varScopep() || !rhsRefp->varScopep()) return;
+
+        AstVarScope* portVscp = nullptr;
+        AstVarScope* actualVscp = nullptr;
+        const AstIfaceRefDType* portDTypep = nullptr;
+        const auto classify = [&](AstVarScope* candidatePortp,
+                                  AstVarScope* candidateActualp) {
+            const AstIfaceRefDType* const dtypep
+                = VN_CAST(candidatePortp->dtypep()->skipRefp(), IfaceRefDType);
+            if (!dtypep || !dtypep->modportp()) return false;
+            portVscp = candidatePortp;
+            actualVscp = candidateActualp;
+            portDTypep = dtypep;
+            return true;
+        };
+        if (!classify(lhsRefp->varScopep(), rhsRefp->varScopep())
+            && !classify(rhsRefp->varScopep(), lhsRefp->varScopep())) {
+            return;
+        }
+
+        AstScope* const actualScopep = actualVscp->scopep();
+        for (const AstNode* modNodep = portDTypep->modportp()->varsp(); modNodep;
+             modNodep = modNodep->nextp()) {
+            const AstModportVarRef* const modRefp = VN_CAST(modNodep, ModportVarRef);
+            if (!modRefp || !modRefp->varp()) continue;
+            const AstVarScope* memberVscp = nullptr;
+            for (const AstVarScope* vscp = actualScopep->varsp(); vscp;
+                 vscp = VN_AS(vscp->nextp(), VarScope)) {
+                if (vscp->varp() == modRefp->varp()) {
+                    memberVscp = vscp;
+                    break;
+                }
+            }
+            if (!memberVscp) continue;
+            PreservedInterfaceMember member;
+            member.syntheticName
+                = toSignalPath(portVscp->scopep()->name(), portVscp->varp()->name()) + "."
+                  + normalizedLocalName(modRefp->name());
+            member.sharedName
+                = toSignalPath(memberVscp->scopep()->name(), memberVscp->varp()->name());
+            member.type = "port";
+            member.width = memberVscp->varp()->width();
+            member.file = modRefp->fileline()->filename();
+            member.line = modRefp->fileline()->lineno();
+            member.direction = xddDirection(modRefp->direction());
+            if (member.direction != 0
+                && seen.emplace(member.syntheticName, member.sharedName).second) {
+                preservedInterfaceMembers().push_back(std::move(member));
+            }
+        }
+    });
+}
+
+void preserveNetDriver(const AstAssignW* nodep, bool replaceLowered) {
+    const AstVarRef* const targetRefp = VN_CAST(nodep->lhsp(), VarRef);
+    if (!targetRefp || !targetRefp->varp()) return;
+    PreservedNetDriver driver;
+    driver.targetName = normalizedLocalName(targetRefp->varp()->name());
+    driver.targetFile = targetRefp->varp()->fileline()->filename();
+    driver.targetLine = targetRefp->varp()->fileline()->lineno();
+    driver.file = nodep->fileline()->filename();
+    driver.line = nodep->fileline()->lineno();
+    driver.replaceLowered = replaceLowered;
+    nodep->rhsp()->foreach([&](const AstNode* childp) {
+        const AstVarRef* const sourceRefp = VN_CAST(childp, VarRef);
+        if (!sourceRefp || !sourceRefp->varp()) return;
+        const std::string name = normalizedLocalName(sourceRefp->varp()->name());
+        if (name != driver.targetName
+            && std::find(driver.sourceNames.begin(), driver.sourceNames.end(), name)
+                   == driver.sourceNames.end()) {
+            driver.sourceNames.push_back(name);
+        }
+    });
+    preservedNetDrivers().push_back(std::move(driver));
+}
+
+void V3EmitDesignDb::preserveRemovedNetDriver(const AstAssignW* nodep) {
+    preserveNetDriver(nodep, false);
+}
+
+void V3EmitDesignDb::preserveLoweredNetDriver(const AstAssignW* nodep) {
+    preserveNetDriver(nodep, true);
+}
