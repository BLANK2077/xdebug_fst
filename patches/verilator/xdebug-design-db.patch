+class AstNetlist;
+
+class V3EmitDesignDb final {
+public:
+    static void captureInterfacePortMembers(AstNetlist* nodep) VL_MT_DISABLED;
+    static void preserveRemovedNetDriver(const AstAssignW* nodep) VL_MT_DISABLED;
+    static void preserveLoweredNetDriver(const AstAssignW* nodep) VL_MT_DISABLED;
+    static void emit(AstNetlist* nodep) VL_MT_DISABLED;
+};
+
+#endif  // Guard
