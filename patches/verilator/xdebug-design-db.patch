+# DESCRIPTION: Shared helpers for Verilator --design-db regression tests
+#
+# SPDX-FileCopyrightText: 2026 Wilson Snyder
+# SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+
+import subprocess
+from pathlib import Path
+
+
+def compile_design_db(test, *, top_filename, mode, other_filenames=None,
+                      extra_flags=None):
+    """Compile one isolated design, build its generated database, and validate it."""
+    other_filenames = other_filenames or []
+    extra_flags = extra_flags or []
+    test.compile(
+        top_filename=top_filename,
+        v_other_filenames=other_filenames,
+        v_flags=["--design-db", *extra_flags],
+        make_main=False,
+        make_top_shell=False,
+        verilator_make_gmake=False,
+    )
+
+    root = Path(test.root).resolve()
+    obj_dir = Path(test.obj_dir).resolve()
+    db_cpp = obj_dir / f"{test.vm_prefix}__DesignDb.cpp"
+    assert db_cpp.exists(), f"DesignDb file not generated: {db_cpp}"
+
+    shared_db = obj_dir / f"lib{test.vm_prefix}__DesignDb.so"
+    subprocess.run(
+        [
+            "g++", "-std=c++17", "-Wall", "-Wextra", "-Werror",
+            "-shared", "-fPIC", f"-I{root / 'include'}",
+            "-o", str(shared_db), str(db_cpp),
+        ],
+        check=True,
+        cwd=root,
+    )
+
+    validator = obj_dir / "validate_trace"
+    subprocess.run(
+        [
+            "cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+            f"-I{root / 'include'}",
+            str(root / "test_regress/t/validate_trace.c"),
+            "-ldl", "-o", str(validator),
+        ],
+        check=True,
+        cwd=root,
+    )
+
+    result = subprocess.run(
+        [str(validator), str(shared_db), mode],
+        capture_output=True,
+        text=True,
+        timeout=60,
+        cwd=root,
+        check=False,
+    )
+    assert result.returncode == 0, (
+        f"DesignDB {mode} validation failed:\n{result.stdout}\n{result.stderr}"
+    )
+    return result.stdout
