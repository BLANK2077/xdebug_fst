diff --git a/src/V3EmitDesignDb.cpp b/src/V3EmitDesignDb.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8e396242deca7b2d8064dfb06b78b1dee54c753b
--- /dev/null
+++ b/src/V3EmitDesignDb.cpp
@@ -0,0 +1,1420 @@
+// -*- mode: C++; c-file-style: "cc-mode" -*-
+//*************************************************************************
+// DESCRIPTION: Verilator: Emit design database for xdebug trace queries
+//
+// SPDX-FileCopyrightText: 2026-2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+//*************************************************************************
+
+#include "V3PchAstNoMT.h"
+#include "V3EmitDesignDb.h"
+#include "V3Ast.h"
+#include "V3EmitV.h"
+#include "V3Global.h"
+#include "V3Os.h"
+#include "V3Stats.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <set>
+#include <tuple>
+#include <vector>
+#include <cstring>
+
+VL_DEFINE_DEBUG_FUNCTIONS;
+
+namespace {
+
+std::string toSignalPath(const std::string& scopeName, const std::string& varName) {
+    std::string full = scopeName + "." + varName;
+    std::string out;
+    out.reserve(full.size());
+    for (size_t i = 0; i < full.size(); ++i) {
+        if (full.compare(i, 7, "__DOT__") == 0) {
+            out += '.';
+            i += 6;
+        } else if (full.compare(i, 7, "__PVT__") == 0) {
+            i += 6;
+        } else {
+            out += static_cast<char>(std::tolower(static_cast<unsigned char>(full[i])));
+        }
+    }
+    return out;
+}
+
+struct SignalInfo {
+    std::string name;
+    std::string type;
+    int width = 0;
+    std::string file;
+    int line = 0;
+    int direction = 0;
+};
+
+struct UnpackedElementInfo {
+    int baseIdx = -1;
+    int elementIdx = -1;
+};
+
+struct PortConnectionInfo {
+    int portIdx = -1;
+    int connectedIdx = -1;
+    std::string kind;
+};
+
+struct PreservedInterfaceMember {
+    std::string syntheticName;
+    std::string sharedName;
+    std::string type;
+    int width = 0;
+    std::string file;
+    int line = 0;
+    int direction = 0;
+};
+
+std::vector<PreservedInterfaceMember>& preservedInterfaceMembers() {
+    static std::vector<PreservedInterfaceMember> members;
+    return members;
+}
+
+int xddDirection(VDirection direction) {
+    if (direction == VDirection::INPUT || direction == VDirection::CONSTREF) return 1;
+    if (direction == VDirection::OUTPUT) return 2;
+    if (direction == VDirection::INOUT || direction == VDirection::REF) return 3;
+    return 0;
+}
+
+int xddDirection(const AstVar* varp) {
+    VDirection direction = varp->declDirection();
+    if (!direction.isAny()) direction = varp->direction();
+    return xddDirection(direction);
+}
+
+struct DriverInfo {
+    int targetIdx = -1;
+    int srcIdx = -1;
+    std::string kind;
+    std::string role;
+    std::string predicate;
+    std::string file;
+    int line = 0;
+};
+
+struct EventDependency {
+    int srcIdx = -1;
+    const char* role = nullptr;
+};
+
+const char* eventDependencyRole(VEdgeType edgeType) {
+    switch (edgeType) {
+    case VEdgeType::ET_POSEDGE: return "event_posedge";
+    case VEdgeType::ET_NEGEDGE: return "event_negedge";
+    case VEdgeType::ET_BOTHEDGE: return "event_bothedge";
+    case VEdgeType::ET_CHANGED: return "event_changed";
+    default: return nullptr;
+    }
+}
+
+std::string replaceAll(std::string text, const std::string& from, const std::string& to) {
+    if (from.empty()) return text;
+    size_t pos = 0;
+    while ((pos = text.find(from, pos)) != std::string::npos) {
+        text.replace(pos, from.size(), to);
+        pos += to.size();
+    }
+    return text;
+}
+
+std::string normalizedExpression(const AstNodeExpr* exprp) {
+    std::string expression = V3EmitV::debugVerilogForTree(exprp);
+    std::vector<std::pair<std::string, std::string>> replacements;
+    exprp->foreach([&](const AstNode* nodep) {
+        const AstVarRef* const refp = VN_CAST(nodep, VarRef);
+        if (!refp || !refp->varScopep()) return;
+        replacements.emplace_back(
+            V3EmitV::debugVerilogForTree(refp),
+            toSignalPath(refp->varScopep()->scopep()->name(), refp->varp()->name()));
+    });
+    std::sort(replacements.begin(), replacements.end(),
+              [](const auto& lhs, const auto& rhs) { return lhs.first.size() > rhs.first.size(); });
+    for (size_t i = 0; i < replacements.size(); ++i) {
+        expression = replaceAll(expression, replacements[i].first,
+                                "__XDD_REF_" + std::to_string(i) + "__");
+    }
+    for (size_t i = 0; i < replacements.size(); ++i) {
+        expression = replaceAll(expression, "__XDD_REF_" + std::to_string(i) + "__",
+                                replacements[i].second);
+    }
+    while (!expression.empty()
+           && std::isspace(static_cast<unsigned char>(expression.back()))) {
+        expression.pop_back();
+    }
+    if (!expression.empty() && expression.back() == ';') expression.pop_back();
+    return expression;
+}
+
+bool statementListContains(const AstNode* headp, const AstNode* nodep) {
+    for (const AstNode* siblingp = headp; siblingp; siblingp = siblingp->nextp()) {
+        if (siblingp == nodep) return true;
+    }
+    return false;
+}
+
+std::string caseItemPredicate(const AstCase* casep, const AstCaseItem* selectedp) {
+    // Preserve the case matching kind in the predicate.  The xdebug consumer
+    // evaluates these internal operators with four-state casez/casex semantics;
+    // case-inside and case-matches use their corresponding static comparison.
+    // Packed matches patterns with wildcard members carry an exact value and
+    // per-bit mask; tagged and binding patterns are rejected before this
+    // emitter rather than being approximated.
+    std::string matchOp;
+    if (casep->caseSimple()) matchOp = "===";
+    else if (casep->casez()) matchOp = "==?z";
+    else if (casep->casex()) matchOp = "==?x";
+    else if (casep->caseInside()) matchOp = "==?i";
+    else if (casep->caseMatches()) matchOp = "===";
+    else return {};
+    const std::string expression = normalizedExpression(casep->exprp());
+    const auto matchesFor = [&](const AstCaseItem* itemp) {
+        std::vector<std::string> matches;
+        for (const AstNodeExpr* condp = itemp->condsp(); condp;
+             condp = VN_AS(condp->nextp(), NodeExpr)) {
+            if (const AstInsideRange* const rangep = VN_CAST(condp, InsideRange)) {
+                matches.push_back("(((" + expression + ") >= ("
+                                  + normalizedExpression(rangep->lhsp()) + ")) && (("
+                                  + expression + ") <= ("
+                                  + normalizedExpression(rangep->rhsp()) + ")))");
+            } else if (const AstPatternTest* const testp = VN_CAST(condp, PatternTest)) {
+                const std::string value = normalizedExpression(testp->valuep());
+                const std::string mask = normalizedExpression(testp->maskp());
+                matches.push_back("(((" + expression + ") & (" + mask + ")) === ((" + value
+                                  + ") & (" + mask + ")))");
+            } else {
+                matches.push_back("((" + expression + ") " + matchOp + " ("
+                                  + normalizedExpression(condp) + "))");
+            }
+        }
+        std::string joined;
+        for (const std::string& match : matches) {
+            if (!joined.empty()) joined += " || ";
+            joined += match;
+        }
+        return joined;
+    };
+    if (!selectedp->isDefault()) return matchesFor(selectedp);
+    std::string anyMatch;
+    for (const AstCaseItem* itemp = casep->itemsp(); itemp;
+         itemp = VN_AS(itemp->nextp(), CaseItem)) {
+        if (itemp->isDefault()) continue;
+        const std::string itemMatch = matchesFor(itemp);
+        if (itemMatch.empty()) continue;
+        if (!anyMatch.empty()) anyMatch += " || ";
+        anyMatch += itemMatch;
+    }
+    return anyMatch.empty() ? "1" : "!(" + anyMatch + ")";
+}
+
+std::string activationPredicate(const AstNodeAssign* assignp) {
+    std::vector<std::string> terms;
+    const AstCaseItem* caseItemp = nullptr;
+    const AstNode* childp = assignp;
+    for (AstNode* parentp = assignp->aboveLoopp(); parentp;
+         parentp = parentp->aboveLoopp()) {
+        if (const AstIf* const ifp = VN_CAST(parentp, If)) {
+            const std::string condition = normalizedExpression(ifp->condp());
+            if (statementListContains(ifp->thensp(), childp)) {
+                terms.push_back("(" + condition + ")");
+            } else if (statementListContains(ifp->elsesp(), childp)) {
+                terms.push_back("!(" + condition + ")");
+            }
+        } else if (const AstCaseItem* const itemp = VN_CAST(parentp, CaseItem)) {
+            caseItemp = itemp;
+        } else if (const AstCase* const casep = VN_CAST(parentp, Case)) {
+            if (caseItemp) {
+                const std::string term = caseItemPredicate(casep, caseItemp);
+                if (term.empty()) return {};
+                terms.push_back(term);
+            }
+            caseItemp = nullptr;
+        }
+        childp = parentp;
+    }
+    std::reverse(terms.begin(), terms.end());
+    std::string predicate;
+    for (const std::string& term : terms) {
+        if (!predicate.empty()) predicate += " && ";
+        predicate += term;
+    }
+    return predicate.empty() ? "1" : predicate;
+}
+
+struct ConditionalBranch {
+    const AstNodeExpr* valuep = nullptr;
+    std::vector<const AstNodeExpr*> controlsp;
+    std::vector<std::string> predicateTerms;
+};
+
+void collectConditionalBranches(const AstNodeExpr* exprp,
+                                const std::vector<const AstNodeExpr*>& controlsp,
+                                const std::vector<std::string>& predicateTerms,
+                                std::vector<ConditionalBranch>& branches) {
+    if (const AstCond* const condp = VN_CAST(exprp, Cond)) {
+        std::vector<const AstNodeExpr*> nestedControls = controlsp;
+        nestedControls.push_back(condp->condp());
+        const std::string condition = normalizedExpression(condp->condp());
+        std::vector<std::string> thenTerms = predicateTerms;
+        thenTerms.push_back("(" + condition + ")");
+        collectConditionalBranches(condp->thenp(), nestedControls, thenTerms, branches);
+        std::vector<std::string> elseTerms = predicateTerms;
+        elseTerms.push_back("!(" + condition + ")");
+        collectConditionalBranches(condp->elsep(), nestedControls, elseTerms, branches);
+        return;
+    }
+    branches.push_back({exprp, controlsp, predicateTerms});
+}
+
+std::string combinePredicate(const std::string& outer,
+                             const std::vector<std::string>& terms) {
+    if (outer.empty()) return {};
+    std::string predicate = outer == "1" ? "" : outer;
+    for (const std::string& term : terms) {
+        if (!predicate.empty()) predicate += " && ";
+        predicate += term;
+    }
+    return predicate.empty() ? "1" : predicate;
+}
+
+std::string cStringEscape(const std::string& text) {
+    std::string escaped;
+    for (const char ch : text) {
+        if (ch == '\\' || ch == '\"') escaped += '\\';
+        if (ch == '\n') escaped += "\\n";
+        else if (ch == '\r') escaped += "\\r";
+        else escaped += ch;
+    }
+    return escaped;
+}
+
+struct LoadInfo {
+    int targetIdx = -1;
+    int consumerIdx = -1;
+    std::string kind;
+    std::string file;
+    int line = 0;
+};
+
+struct PreservedNetDriver {
+    std::string targetName;
+    std::string targetFile;
+    int targetLine = 0;
+    std::vector<std::string> sourceNames;
+    std::string file;
+    int line = 0;
+    bool replaceLowered = false;
+};
+
+std::vector<PreservedNetDriver>& preservedNetDrivers() {
+    static std::vector<PreservedNetDriver> drivers;
+    return drivers;
+}
+
+std::string normalizedLocalName(const std::string& name) {
+    const std::string path = toSignalPath("", name);
+    return !path.empty() && path[0] == '.' ? path.substr(1) : path;
+}
+
+bool endsWithSignalName(const std::string& path, const std::string& name) {
+    return path == name
+           || (path.size() > name.size() && path[path.size() - name.size() - 1] == '.'
+               && path.compare(path.size() - name.size(), name.size(), name) == 0);
+}
+
+void appendPreservedNetDrivers(const std::vector<SignalInfo>& signals,
+                               std::vector<DriverInfo>& drivers,
+                               std::vector<LoadInfo>& loads) {
+    for (const PreservedNetDriver& preserved : preservedNetDrivers()) {
+        if (!preserved.replaceLowered) continue;
+        for (size_t targetIdx = 0; targetIdx < signals.size(); ++targetIdx) {
+            const SignalInfo& target = signals[targetIdx];
+            if (!endsWithSignalName(target.name, preserved.targetName)
+                || target.file != preserved.targetFile || target.line != preserved.targetLine) {
+                continue;
+            }
+            const std::string generatedPrefix = target.name + "__";
+            const auto isGeneratedSource = [&](int sourceIdx) {
+                return sourceIdx >= 0 && static_cast<size_t>(sourceIdx) < signals.size()
+                       && signals[sourceIdx].name.compare(
+                              0, generatedPrefix.size(), generatedPrefix)
+                              == 0;
+            };
+            drivers.erase(std::remove_if(drivers.begin(), drivers.end(), [&](const DriverInfo& d) {
+                              return d.targetIdx == static_cast<int>(targetIdx)
+                                     && isGeneratedSource(d.srcIdx);
+                          }),
+                          drivers.end());
+            loads.erase(std::remove_if(loads.begin(), loads.end(), [&](const LoadInfo& load) {
+                            return load.consumerIdx == static_cast<int>(targetIdx)
+                                   && isGeneratedSource(load.targetIdx);
+                        }),
+                        loads.end());
+        }
+    }
+    std::set<std::tuple<int, int, std::string, int>> seen;
+    for (const DriverInfo& driver : drivers) {
+        seen.emplace(driver.targetIdx, driver.srcIdx, driver.file, driver.line);
+    }
+    for (const PreservedNetDriver& preserved : preservedNetDrivers()) {
+        for (size_t targetIdx = 0; targetIdx < signals.size(); ++targetIdx) {
+            const SignalInfo& target = signals[targetIdx];
+            if (!endsWithSignalName(target.name, preserved.targetName)
+                || target.file != preserved.targetFile || target.line != preserved.targetLine) {
+                continue;
+            }
+            const size_t separator = target.name.rfind('.');
+            const std::string prefix
+                = separator == std::string::npos ? std::string{} : target.name.substr(0, separator);
+            bool appended = false;
+            for (const std::string& sourceName : preserved.sourceNames) {
+                const std::string expected
+                    = prefix.empty() ? sourceName : prefix + "." + sourceName;
+                const auto sourceIt = std::find_if(
+                    signals.begin(), signals.end(), [&](const SignalInfo& signal) {
+                        return signal.name == expected;
+                    });
+                if (sourceIt == signals.end()) continue;
+                const int sourceIdx = static_cast<int>(sourceIt - signals.begin());
+                const auto key = std::make_tuple(static_cast<int>(targetIdx), sourceIdx,
+                                                 preserved.file, preserved.line);
+                if (!seen.insert(key).second) continue;
+                drivers.push_back({static_cast<int>(targetIdx), sourceIdx, "cont_assign", "rhs",
+                                   "1", preserved.file, preserved.line});
+                loads.push_back({sourceIdx, static_cast<int>(targetIdx), "rhs_use",
+                                 preserved.file, preserved.line});
+                appended = true;
+            }
+            if (!appended) {
+                const auto key = std::make_tuple(static_cast<int>(targetIdx), -1,
+                                                 preserved.file, preserved.line);
+                if (seen.insert(key).second) {
+                    drivers.push_back({static_cast<int>(targetIdx), -1, "cont_assign",
+                                       "statement", "1", preserved.file, preserved.line});
+                }
+            }
+        }
+    }
+    preservedNetDrivers().clear();
+}
+
+// =========================================================================
+// Phase 1: Collect signals
+
+void appendUnpackedElementSignals(const AstNodeDType* dtypep, const SignalInfo& base,
+                                  const std::string& suffix, int baseIdx,
+                                  std::vector<SignalInfo>& signals,
+                                  std::vector<UnpackedElementInfo>& elements) {
+    const AstUnpackArrayDType* const unpackp = VN_CAST(dtypep->skipRefp(), UnpackArrayDType);
+    if (!unpackp) {
+        SignalInfo element = base;
+        element.name += suffix;
+        element.width = dtypep->width();
+        const int elementIdx = static_cast<int>(signals.size());
+        signals.push_back(std::move(element));
+        elements.push_back({baseIdx, elementIdx});
+        return;
+    }
+    const VNumRange range = unpackp->declRange();
+    const int step = range.left() <= range.right() ? 1 : -1;
+    for (int index = range.left();; index += step) {
+        appendUnpackedElementSignals(unpackp->subDTypep(), base,
+                                     suffix + "[" + std::to_string(index) + "]", baseIdx, signals,
+                                     elements);
+        if (index == range.right()) break;
+    }
+}
+
+void collectSignals(AstNetlist* nodep, std::vector<SignalInfo>& signals,
+                    std::map<const AstVarScope*, int>& scopeMap,
+                    std::vector<UnpackedElementInfo>& unpackedElements) {
+    std::set<std::string> seen;
+    nodep->foreach([&](AstNode* np) {
+        if (!VN_IS(np, VarScope)) return;
+        AstVarScope* vscp = VN_AS(np, VarScope);
+        AstVar* varp = vscp->varp();
+        if (!varp) return;
+        const std::string& vn = varp->name();
+        if (vn.empty() || vn.find("__V") == 0 || varp->isParam()) return;
+
+        SignalInfo info;
+        info.name = toSignalPath(vscp->scopep()->name(), vn);
+        info.width = varp->width();
+        info.file = vscp->fileline()->filename();
+        info.line = vscp->fileline()->lineno();
+        info.direction = xddDirection(varp);
+
+        if (info.direction != 0)
+            info.type = "port";
+        else if (varp->isWritable() && varp->isNonOutput())
+            info.type = "reg";
+        else
+            info.type = "wire";
+
+        if (!seen.insert(info.name).second) return;
+
+        const int idx = static_cast<int>(signals.size());
+        scopeMap[vscp] = idx;
+        signals.push_back(info);
+        if (VN_IS(varp->dtypep()->skipRefp(), UnpackArrayDType)) {
+            appendUnpackedElementSignals(varp->dtypep(), info, "", idx, signals, unpackedElements);
+        }
+    });
+}
+
+void appendUnpackedElementRelationships(const std::vector<UnpackedElementInfo>& elements,
+                                        std::vector<DriverInfo>& drivers,
+                                        std::vector<LoadInfo>& loads) {
+    const std::vector<DriverInfo> originalDrivers = drivers;
+    const std::vector<LoadInfo> originalLoads = loads;
+    for (const UnpackedElementInfo& element : elements) {
+        for (const DriverInfo& driver : originalDrivers) {
+            if (driver.targetIdx != element.baseIdx) continue;
+            DriverInfo copy = driver;
+            copy.targetIdx = element.elementIdx;
+            drivers.push_back(std::move(copy));
+        }
+        for (const LoadInfo& load : originalLoads) {
+            if (load.targetIdx == element.baseIdx) {
+                LoadInfo copy = load;
+                copy.targetIdx = element.elementIdx;
+                loads.push_back(std::move(copy));
+            }
+            if (load.consumerIdx == element.baseIdx) {
+                LoadInfo copy = load;
+                copy.consumerIdx = element.elementIdx;
+                loads.push_back(std::move(copy));
+            }
+        }
+    }
+}
+
+void appendInterfaceMemberSignals(std::vector<SignalInfo>& signals,
+                                  std::vector<PortConnectionInfo>& connections,
+                                  std::vector<std::pair<int, int>>& memberIndices) {
+    std::map<std::string, int> signalByName;
+    for (size_t idx = 0; idx < signals.size(); ++idx) {
+        signalByName.emplace(signals[idx].name, static_cast<int>(idx));
+    }
+    for (const PreservedInterfaceMember& member : preservedInterfaceMembers()) {
+        const auto sharedIt = signalByName.find(member.sharedName);
+        if (sharedIt == signalByName.end()) continue;
+        auto syntheticIt = signalByName.find(member.syntheticName);
+        if (syntheticIt == signalByName.end()) {
+            const int syntheticIdx = static_cast<int>(signals.size());
+            signals.push_back({member.syntheticName, member.type, member.width, member.file,
+                               member.line, member.direction});
+            syntheticIt = signalByName.emplace(member.syntheticName, syntheticIdx).first;
+        }
+        connections.push_back(
+            {syntheticIt->second, sharedIt->second, "interface_modport_member"});
+        memberIndices.emplace_back(syntheticIt->second, sharedIt->second);
+    }
+}
+
+void appendInterfaceMemberDrivers(const std::vector<SignalInfo>& signals,
+                                  const std::vector<std::pair<int, int>>& memberIndices,
+                                  std::vector<DriverInfo>& drivers,
+                                  std::vector<LoadInfo>& loads) {
+    const std::vector<DriverInfo> originalDrivers = drivers;
+    std::set<std::tuple<int, int, std::string, std::string, int>> seen;
+    for (const DriverInfo& driver : drivers) {
+        seen.emplace(driver.targetIdx, driver.srcIdx, driver.kind, driver.file, driver.line);
+    }
+    for (const auto& indices : memberIndices) {
+        const int syntheticIdx = indices.first;
+        const int sharedIdx = indices.second;
+        if (signals[syntheticIdx].direction != 2 && signals[syntheticIdx].direction != 3) continue;
+        for (const DriverInfo& driver : originalDrivers) {
+            if (driver.targetIdx != sharedIdx) continue;
+            const auto key = std::make_tuple(syntheticIdx, driver.srcIdx, driver.kind,
+                                             driver.file, driver.line);
+            if (!seen.insert(key).second) continue;
+            DriverInfo memberDriver = driver;
+            memberDriver.targetIdx = syntheticIdx;
+            drivers.push_back(memberDriver);
+            if (driver.srcIdx >= 0) {
+                loads.push_back({driver.srcIdx, syntheticIdx, "rhs_use", driver.file,
+                                 driver.line});
+            }
+        }
+    }
+}
+
+std::vector<PortConnectionInfo> collectPortConnections(
+    const std::vector<SignalInfo>& signals,
+    const std::vector<DriverInfo>& drivers) {
+    std::vector<PortConnectionInfo> connections;
+    std::set<std::tuple<int, int>> seen;
+    const auto append = [&](int portIdx, int connectedIdx) {
+        if (portIdx < 0 || connectedIdx < 0 || portIdx == connectedIdx) return;
+        if (signals[portIdx].direction == 0) return;
+        if (!seen.emplace(portIdx, connectedIdx).second) return;
+        connections.push_back({portIdx, connectedIdx, "port_boundary"});
+    };
+    for (const DriverInfo& driver : drivers) {
+        if (driver.kind != "cont_assign" || driver.targetIdx < 0
+            || driver.srcIdx < 0) {
+            continue;
+        }
+        append(driver.targetIdx, driver.srcIdx);
+        append(driver.srcIdx, driver.targetIdx);
+    }
+    return connections;
+}
+
+// =========================================================================
+// Phase 2: Collect drivers and loads
+
+void collectDriversAndLoads(AstNetlist* nodep,
+                            const std::map<const AstVarScope*, int>& scopeMap,
+                            std::vector<DriverInfo>& drivers,
+                            std::vector<LoadInfo>& loads) {
+    // For each assignment, find the LHS signal (target) and RHS signals (sources)
+    nodep->foreach([&](AstNode* np) {
+        if (!VN_IS(np, NodeAssign)) return;
+        AstNodeAssign* assignp = VN_AS(np, NodeAssign);
+
+        // Determine kind
+        std::string kind;
+        if (VN_IS(assignp, AssignForce)) kind = "force";
+        else if (VN_IS(assignp, AssignDly)) kind = "nba";
+        else if (VN_IS(assignp, AssignCont)) kind = "cont_assign";
+        else if (VN_IS(assignp, AssignW)) kind = "cont_assign";
+        else kind = "proc_assign";
+
+        // Find LHS target signal
+        int targetIdx = -1;
+        assignp->lhsp()->foreach([&](AstNode* lnode) {
+            if (const AstVarRef* refp = VN_CAST(lnode, VarRef)) {
+                if (refp->access().isWriteOrRW() && refp->varScopep()) {
+                    auto it = scopeMap.find(refp->varScopep());
+                    if (it != scopeMap.end()) targetIdx = it->second;
+                }
+            }
+        });
+
+        // Preserve loop variables used to select the assignment target.  They
+        // are transient elaborated execution state and normally have no
+        // waveform value, so consumers need an explicit role to bind them to
+        // the queried unpacked element or packed bit instead of treating them
+        // as ordinary runtime controls.
+        std::set<int> targetLoopIndices;
+        assignp->lhsp()->foreach([&](AstNode* lnode) {
+            const AstNodeExpr* selectorp = nullptr;
+            if (const AstArraySel* const selp = VN_CAST(lnode, ArraySel)) {
+                selectorp = selp->bitp();
+            } else if (const AstSel* const selp = VN_CAST(lnode, Sel)) {
+                selectorp = selp->lsbp();
+            }
+            if (!selectorp) return;
+            selectorp->foreach([&](const AstNode* selectorNodep) {
+                const AstVarRef* const refp = VN_CAST(selectorNodep, VarRef);
+                if (!refp || !refp->varScopep() || !refp->varp()->isUsedLoopIdx()) return;
+                const auto it = scopeMap.find(refp->varScopep());
+                if (it != scopeMap.end()) targetLoopIndices.insert(it->second);
+            });
+        });
+
+        const std::string outerPredicate = activationPredicate(assignp);
+
+        // An assignment can execute without changing its target value.  Keep
+        // direct sensitivity signals as statement-local event dependencies so
+        // a waveform consumer can recover that execution opportunity from the
+        // clock/reset transitions instead of guessing from target changes.
+        std::vector<EventDependency> eventDependencies;
+        for (AstNode* parentp = assignp->aboveLoopp(); parentp;
+             parentp = parentp->aboveLoopp()) {
+            const AstAlways* const alwaysp = VN_CAST(parentp, Always);
+            if (!alwaysp) continue;
+            if (const AstSenTree* const sentreep = alwaysp->sentreep()) {
+                for (const AstSenItem* itemp = sentreep->sensesp(); itemp;
+                     itemp = VN_AS(itemp->nextp(), SenItem)) {
+                    const char* const role = eventDependencyRole(itemp->edgeType());
+                    const AstVarRef* const refp = VN_CAST(itemp->sensp(), VarRef);
+                    if (!role || !refp || !refp->varScopep()) continue;
+                    const auto it = scopeMap.find(refp->varScopep());
+                    if (it == scopeMap.end()) continue;
+                    const EventDependency dependency{it->second, role};
+                    const auto duplicate = std::find_if(
+                        eventDependencies.begin(), eventDependencies.end(),
+                        [&](const EventDependency& existing) {
+                            return existing.srcIdx == dependency.srcIdx
+                                   && std::string{existing.role} == dependency.role;
+                        });
+                    if (duplicate == eventDependencies.end()) {
+                        eventDependencies.push_back(dependency);
+                    }
+                }
+            }
+            break;
+        }
+
+        // Find control signals (enclosing If/Case condition)
+        std::vector<int> controlIndices;
+        for (AstNode* parentp = assignp->aboveLoopp(); parentp;
+             parentp = parentp->aboveLoopp()) {
+            if (const AstIf* ifp = VN_CAST(parentp, If)) {
+                ifp->condp()->foreach([&](AstNode* cnode) {
+                    if (const AstVarRef* refp = VN_CAST(cnode, VarRef)) {
+                        if (refp->varScopep()) {
+                            auto it = scopeMap.find(refp->varScopep());
+                            if (it != scopeMap.end())
+                                controlIndices.push_back(it->second);
+                        }
+                    }
+                });
+            }
+            if (const AstCase* casep = VN_CAST(parentp, Case)) {
+                casep->exprp()->foreach([&](AstNode* cnode) {
+                    if (const AstVarRef* refp = VN_CAST(cnode, VarRef)) {
+                        if (refp->varScopep()) {
+                            auto it = scopeMap.find(refp->varScopep());
+                            if (it != scopeMap.end())
+                                controlIndices.push_back(it->second);
+                        }
+                    }
+                });
+            }
+        }
+
+        // Record entry if we found a target.  V3Inst may have folded nested
+        // same-target assignments into an AstCond RHS.  Split those leaves so
+        // their source locations and activation predicates remain observable.
+        if (targetIdx < 0) return;
+        std::vector<ConditionalBranch> branches;
+        collectConditionalBranches(assignp->rhsp(), {}, {}, branches);
+        for (const ConditionalBranch& branch : branches) {
+            std::vector<int> rhsIndices;
+            std::set<int> rhsLoopSelectedIndices;
+            std::set<int> rhsLoopIndices;
+            // Keep loop-selected RHS bases distinct from independent RHS
+            // operands.  Existing role accessors carry both facts without an
+            // ABI or layout change.
+            branch.valuep->foreach([&](const AstNode* rnode) {
+                if (const AstVarRef* refp = VN_CAST(rnode, VarRef)) {
+                    if (refp->varScopep()) {
+                        const auto it = scopeMap.find(refp->varScopep());
+                        if (it != scopeMap.end()) rhsIndices.push_back(it->second);
+                    }
+                }
+                const AstNodeExpr* fromp = nullptr;
+                const AstNodeExpr* selectorp = nullptr;
+                if (const AstArraySel* const selp = VN_CAST(rnode, ArraySel)) {
+                    fromp = selp->fromp();
+                    selectorp = selp->bitp();
+                } else if (const AstSel* const selp = VN_CAST(rnode, Sel)) {
+                    fromp = selp->fromp();
+                    selectorp = selp->lsbp();
+                }
+                if (!fromp || !selectorp) return;
+                bool usesLoopIndex = false;
+                selectorp->foreach([&](const AstNode* selectorNodep) {
+                    const AstVarRef* const refp = VN_CAST(selectorNodep, VarRef);
+                    if (!refp || !refp->varScopep()
+                        || !refp->varp()->isUsedLoopIdx()) return;
+                    const auto it = scopeMap.find(refp->varScopep());
+                    if (it == scopeMap.end()) return;
+                    rhsLoopIndices.insert(it->second);
+                    usesLoopIndex = true;
+                });
+                const AstVarRef* const baseRefp = VN_CAST(fromp, VarRef);
+                if (!usesLoopIndex || !baseRefp || !baseRefp->varScopep()) return;
+                const auto it = scopeMap.find(baseRefp->varScopep());
+                if (it != scopeMap.end()) rhsLoopSelectedIndices.insert(it->second);
+            });
+            std::vector<int> branchControlIndices = controlIndices;
+            for (const AstNodeExpr* const conditionp : branch.controlsp) {
+                conditionp->foreach([&](const AstNode* cnode) {
+                    if (const AstVarRef* refp = VN_CAST(cnode, VarRef)) {
+                        if (refp->varScopep()) {
+                            const auto it = scopeMap.find(refp->varScopep());
+                            if (it != scopeMap.end()) branchControlIndices.push_back(it->second);
+                        }
+                    }
+                });
+            }
+            const std::string predicate
+                = combinePredicate(outerPredicate, branch.predicateTerms);
+            const FileLine* const filelinep = branch.valuep->fileline();
+            const AstVarRef* const directRhsp = VN_CAST(branch.valuep, VarRef);
+            const bool directSelfRhs
+                = directRhsp && directRhsp->varScopep()
+                  && scopeMap.find(directRhsp->varScopep()) != scopeMap.end()
+                  && scopeMap.find(directRhsp->varScopep())->second == targetIdx;
+            const auto appendDependency = [&](int srcIdx, const char* role) {
+                if (srcIdx == targetIdx) {
+                    if (directSelfRhs && std::string{role} == "rhs") {
+                        drivers.push_back({targetIdx, srcIdx, kind, "self_rhs", predicate,
+                                           filelinep->filename(), filelinep->lineno()});
+                    }
+                    return;
+                }
+                drivers.push_back({targetIdx, srcIdx, kind, role, predicate,
+                                   filelinep->filename(), filelinep->lineno()});
+            };
+            for (int srcIdx : rhsIndices) appendDependency(srcIdx, "rhs");
+            for (int srcIdx : rhsLoopSelectedIndices) {
+                appendDependency(srcIdx, "rhs_loop_selected");
+            }
+            for (int srcIdx : rhsLoopIndices) { appendDependency(srcIdx, "rhs_loop_index"); }
+            for (int srcIdx : branchControlIndices) appendDependency(srcIdx, "control");
+            for (int srcIdx : targetLoopIndices) { appendDependency(srcIdx, "target_loop_index"); }
+            if (rhsIndices.empty() && branchControlIndices.empty()) {
+                drivers.push_back({targetIdx, -1, kind, "statement", predicate,
+                                   filelinep->filename(), filelinep->lineno()});
+            }
+            for (const EventDependency& dependency : eventDependencies) {
+                drivers.push_back({targetIdx, dependency.srcIdx, kind, dependency.role,
+                                   predicate, filelinep->filename(), filelinep->lineno()});
+            }
+            const auto appendLoad = [&](int srcIdx, const char* loadKind) {
+                loads.push_back({srcIdx, targetIdx, loadKind, filelinep->filename(),
+                                 filelinep->lineno()});
+            };
+            for (int srcIdx : rhsIndices) appendLoad(srcIdx, "rhs_use");
+            for (int srcIdx : branchControlIndices) appendLoad(srcIdx, "control_use");
+        }
+    });
+}
+
+// =========================================================================
+// Phase 3: Generate C++ output file
+
+void appendU32(std::vector<uint8_t>& out, uint32_t value) {
+    for (int byte = 0; byte < 4; ++byte) out.push_back((value >> (byte * 8)) & 0xff);
+}
+
+void appendU64(std::vector<uint8_t>& out, uint64_t value) {
+    for (int byte = 0; byte < 8; ++byte) out.push_back((value >> (byte * 8)) & 0xff);
+}
+
+void appendI32(std::vector<uint8_t>& out, int value) {
+    appendU32(out, static_cast<uint32_t>(value));
+}
+
+uint32_t internString(const std::string& value, std::map<std::string, uint32_t>& offsets,
+                      std::vector<uint8_t>& strings) {
+    const auto found = offsets.find(value);
+    if (found != offsets.end()) return found->second;
+    const uint32_t offset = static_cast<uint32_t>(strings.size());
+    offsets.emplace(value, offset);
+    strings.insert(strings.end(), value.begin(), value.end());
+    strings.push_back(0);
+    return offset;
+}
+
+template <typename Record>
+std::vector<const Record*> groupRecords(int count, const std::vector<Record>& records,
+                                        std::vector<uint64_t>& starts) {
+    std::vector<uint64_t> sizes(count, 0);
+    for (const auto& record : records) {
+        if (record.targetIdx >= 0 && record.targetIdx < count) ++sizes[record.targetIdx];
+    }
+    starts.resize(count + 1, 0);
+    for (int index = 0; index < count; ++index) starts[index + 1] = starts[index] + sizes[index];
+    std::vector<const Record*> ordered(starts[count]);
+    std::vector<uint64_t> fill = starts;
+    for (const auto& record : records) {
+        if (record.targetIdx >= 0 && record.targetIdx < count)
+            ordered[fill[record.targetIdx]++] = &record;
+    }
+    return ordered;
+}
+
+template <>
+std::vector<const PortConnectionInfo*> groupRecords(
+    int count, const std::vector<PortConnectionInfo>& records,
+    std::vector<uint64_t>& starts) {
+    std::vector<uint64_t> sizes(count, 0);
+    for (const auto& record : records) {
+        if (record.portIdx >= 0 && record.portIdx < count) ++sizes[record.portIdx];
+    }
+    starts.resize(count + 1, 0);
+    for (int index = 0; index < count; ++index) starts[index + 1] = starts[index] + sizes[index];
+    std::vector<const PortConnectionInfo*> ordered(starts[count]);
+    std::vector<uint64_t> fill = starts;
+    for (const auto& record : records) {
+        if (record.portIdx >= 0 && record.portIdx < count)
+            ordered[fill[record.portIdx]++] = &record;
+    }
+    return ordered;
+}
+
+void emitBinary(const std::vector<SignalInfo>& signals,
+                const std::vector<DriverInfo>& drivers,
+                const std::vector<LoadInfo>& loads,
+                const std::vector<PortConnectionInfo>& connections) {
+    constexpr uint32_t headerSize = 176;
+    const int count = static_cast<int>(signals.size());
+    std::map<std::string, uint32_t> stringOffsets{{"", 0}};
+    std::vector<uint8_t> strings{0};
+    std::vector<uint8_t> signalData;
+    std::vector<std::pair<std::string, int>> names;
+    names.reserve(signals.size());
+    for (int index = 0; index < count; ++index) {
+        const auto& signal = signals[index];
+        appendU32(signalData, internString(signal.name, stringOffsets, strings));
+        appendU32(signalData, internString(signal.type, stringOffsets, strings));
+        appendU32(signalData, internString(signal.file, stringOffsets, strings));
+        appendI32(signalData, signal.width);
+        appendI32(signalData, signal.line);
+        appendI32(signalData, signal.direction);
+        names.emplace_back(signal.name, index);
+    }
+    std::sort(names.begin(), names.end());
+    std::vector<uint8_t> nameData;
+    for (const auto& name : names) {
+        appendU32(nameData, internString(name.first, stringOffsets, strings));
+        appendI32(nameData, name.second);
+    }
+
+    std::vector<uint64_t> driverStarts;
+    const auto orderedDrivers = groupRecords(count, drivers, driverStarts);
+    std::vector<uint8_t> driverData;
+    for (const DriverInfo* const driverp : orderedDrivers) {
+        const DriverInfo& driver = *driverp;
+        appendI32(driverData, driver.targetIdx);
+        appendI32(driverData, driver.srcIdx);
+        appendU32(driverData, internString(driver.kind, stringOffsets, strings));
+        appendU32(driverData, internString(driver.role, stringOffsets, strings));
+        appendU32(driverData, internString(driver.predicate, stringOffsets, strings));
+        appendU32(driverData, internString(driver.file, stringOffsets, strings));
+        appendI32(driverData, driver.line);
+    }
+    std::vector<uint8_t> driverStartData;
+    for (uint64_t start : driverStarts) appendU64(driverStartData, start);
+
+    std::vector<uint64_t> loadStarts;
+    const auto orderedLoads = groupRecords(count, loads, loadStarts);
+    std::vector<uint8_t> loadData;
+    for (const LoadInfo* const loadp : orderedLoads) {
+        const LoadInfo& load = *loadp;
+        appendI32(loadData, load.targetIdx);
+        appendI32(loadData, load.consumerIdx);
+        appendU32(loadData, internString(load.kind, stringOffsets, strings));
+        appendU32(loadData, internString(load.file, stringOffsets, strings));
+        appendI32(loadData, load.line);
+    }
+    std::vector<uint8_t> loadStartData;
+    for (uint64_t start : loadStarts) appendU64(loadStartData, start);
+
+    std::vector<uint64_t> connectionStarts;
+    const auto orderedConnections = groupRecords(count, connections, connectionStarts);
+    std::vector<uint8_t> connectionData;
+    for (const PortConnectionInfo* const connectionp : orderedConnections) {
+        const PortConnectionInfo& connection = *connectionp;
+        appendI32(connectionData, connection.portIdx);
+        appendI32(connectionData, connection.connectedIdx);
+        appendU32(connectionData, internString(connection.kind, stringOffsets, strings));
+    }
+    std::vector<uint8_t> connectionStartData;
+    for (uint64_t start : connectionStarts) appendU64(connectionStartData, start);
+
+    struct SectionData final {
+        const std::vector<uint8_t>* bytes;
+        uint64_t count;
+        uint64_t offset = 0;
+    };
+    std::vector<SectionData> sections{
+        {&signalData, signals.size()}, {&nameData, names.size()},
+        {&driverData, orderedDrivers.size()}, {&driverStartData, driverStarts.size()},
+        {&loadData, orderedLoads.size()}, {&loadStartData, loadStarts.size()},
+        {&connectionData, orderedConnections.size()},
+        {&connectionStartData, connectionStarts.size()}, {&strings, strings.size()}};
+    uint64_t offset = headerSize;
+    for (auto& section : sections) {
+        offset = (offset + 7) & ~uint64_t{7};
+        section.offset = offset;
+        offset += section.bytes->size();
+    }
+    std::vector<uint8_t> header;
+    header.reserve(headerSize);
+    header.insert(header.end(), {'X', 'D', 'D', 'B', 'I', 'N', '1', 0});
+    appendU32(header, 1);
+    appendU32(header, 0);
+    appendU32(header, 0x01020304);
+    appendU32(header, headerSize);
+    appendU64(header, offset);
+    for (const auto& section : sections) {
+        appendU64(header, section.offset);
+        appendU64(header, section.count);
+    }
+    const std::string filename = v3Global.opt.prefix() + "__DesignDb.xddb";
+    const std::string path = v3Global.opt.makeDir() + "/" + filename;
+    const std::string temporaryPath = path + ".tmp";
+    const std::string manifestPath
+        = v3Global.opt.makeDir() + "/xdebug-design-db.json";
+    const std::string temporaryManifestPath = manifestPath + ".tmp";
+    V3Os::createDir(v3Global.opt.makeDir());
+    std::remove(temporaryPath.c_str());
+    std::remove(temporaryManifestPath.c_str());
+    std::ofstream stream(temporaryPath, std::ios::binary | std::ios::trunc);
+    if (!stream) {
+        v3Global.rootp()->v3error("Cannot write binary design database temporary file: "
+                                  + temporaryPath);
+        return;
+    }
+    stream.write(reinterpret_cast<const char*>(header.data()),
+                 static_cast<std::streamsize>(header.size()));
+    uint64_t written = header.size();
+    const char zeros[8] = {};
+    for (const auto& section : sections) {
+        const uint64_t padding = section.offset - written;
+        stream.write(zeros, static_cast<std::streamsize>(padding));
+        stream.write(reinterpret_cast<const char*>(section.bytes->data()),
+                     static_cast<std::streamsize>(section.bytes->size()));
+        written = section.offset + section.bytes->size();
+    }
+    stream.flush();
+    const bool databaseWritten = stream.good();
+    stream.close();
+    if (!databaseWritten || stream.fail()) {
+        std::remove(temporaryPath.c_str());
+        v3Global.rootp()->v3error("Cannot complete binary design database file: " + path);
+        return;
+    }
+
+    std::ofstream manifest(temporaryManifestPath, std::ios::out | std::ios::trunc);
+    if (!manifest) {
+        std::remove(temporaryPath.c_str());
+        v3Global.rootp()->v3error("Cannot write DesignDB bundle manifest temporary file: "
+                                  + temporaryManifestPath);
+        return;
+    }
+    manifest << "{\n"
+             << "  \"schema_version\": \"xdebug.design-db-bundle.v2\",\n"
+             << "  \"format\": \"binary-v1\",\n"
+             << "  \"database\": \"" << filename << "\"\n"
+             << "}\n";
+    manifest.flush();
+    const bool manifestWritten = manifest.good();
+    manifest.close();
+    if (!manifestWritten || manifest.fail()) {
+        std::remove(temporaryPath.c_str());
+        std::remove(temporaryManifestPath.c_str());
+        v3Global.rootp()->v3error("Cannot complete DesignDB bundle manifest file: "
+                                  + manifestPath);
+        return;
+    }
+
+    // The manifest is the bundle's visibility/commit point. Remove an older
+    // manifest first so readers fail closed while the database is replaced.
+    if (std::remove(manifestPath.c_str()) != 0 && errno != ENOENT) {
+        std::remove(temporaryPath.c_str());
+        std::remove(temporaryManifestPath.c_str());
+        v3Global.rootp()->v3error("Cannot retire previous DesignDB bundle manifest: "
+                                  + manifestPath);
+        return;
+    }
+    if (std::remove(path.c_str()) != 0 && errno != ENOENT) {
+        std::remove(temporaryPath.c_str());
+        std::remove(temporaryManifestPath.c_str());
+        v3Global.rootp()->v3error("Cannot retire previous binary design database: "
+                                  + path);
+        return;
+    }
+    if (std::rename(temporaryPath.c_str(), path.c_str()) != 0) {
+        std::remove(temporaryPath.c_str());
+        std::remove(temporaryManifestPath.c_str());
+        v3Global.rootp()->v3error("Cannot publish binary design database file: " + path);
+        return;
+    }
+    if (std::rename(temporaryManifestPath.c_str(), manifestPath.c_str()) != 0) {
+        std::remove(temporaryManifestPath.c_str());
+        v3Global.rootp()->v3error("Cannot publish DesignDB bundle manifest file: "
+                                  + manifestPath);
+    }
+}
+
+void emitCpp(const std::vector<SignalInfo>& signals,
+             const std::vector<DriverInfo>& drivers,
+             const std::vector<LoadInfo>& loads,
+             const std::vector<PortConnectionInfo>& connections) {
+    const std::string filename = v3Global.opt.prefix() + "__DesignDb.cpp";
+    const std::string path = v3Global.opt.makeDir() + "/" + filename;
+    // Ensure output directory exists (may not exist yet at this point in pipeline)
+    V3Os::createDir(v3Global.opt.makeDir());
+    std::ofstream out(path);
+    if (!out) {
+        v3Global.rootp()->v3error("Cannot write design database file: " + path);
+        return;
+    }
+
+    out << "// Generated by Verilator --design-db. Do not edit.\n";
+    out << "#include \"xdd_api.h\"\n";
+    out << "#include <cstring>\n\n";
+
+    // Signal table
+    const int N = static_cast<int>(signals.size());
+    out << "static const XddSignalInfo kSignals[] = {\n";
+    for (const auto& s : signals) {
+        out << "    {\"" << s.name << "\", \"" << s.type << "\", "
+            << s.width << ", \"" << s.file << "\", " << s.line << "},\n";
+    }
+    out << "};\n";
+    out << "static const int kSignalCount = " << N << ";\n\n";
+
+    out << "static const int kSignalDirections[] = {";
+    for (int i = 0; i < N; ++i) {
+        if (i) out << ", ";
+        out << signals[i].direction;
+    }
+    out << "};\n";
+    out << "\n";
+
+    // Name index (sorted)
+    std::vector<std::pair<std::string, int>> nameIdx;
+    nameIdx.reserve(N);
+    for (int i = 0; i < N; ++i) nameIdx.emplace_back(signals[i].name, i);
+    std::sort(nameIdx.begin(), nameIdx.end());
+    out << "static const XddNameEntry kNameIndex[] = {\n";
+    for (const auto& e : nameIdx)
+        out << "    {\"" << e.first << "\", " << e.second << "},\n";
+    out << "};\n";
+    out << "static const int kNameIndexCount = " << nameIdx.size() << ";\n\n";
+
+    // Driver table
+    std::vector<int> drvCnt(N, 0), drvStart(N, 0);
+    for (const auto& d : drivers)
+        if (d.targetIdx >= 0 && d.targetIdx < N) ++drvCnt[d.targetIdx];
+    int pos = 0;
+    for (int i = 0; i < N; ++i) { drvStart[i] = pos; pos += drvCnt[i]; }
+    std::vector<DriverInfo> drvOrd(drivers.size());
+    std::vector<int> drvFill = drvStart;
+    for (const auto& d : drivers)
+        if (d.targetIdx >= 0 && d.targetIdx < N)
+            drvOrd[drvFill[d.targetIdx]++] = d;
+
+    out << "static const XddDriverRec kDrivers[] = {\n";
+    for (const auto& d : drvOrd)
+        out << "    {" << d.targetIdx << ", " << d.srcIdx << ", \""
+            << d.kind << "\", \"" << d.role << "\", \"" << d.file
+            << "\", " << d.line << "},\n";
+    out << "};\n";
+    out << "static const int kDriverCount = " << drvOrd.size() << ";\n";
+    out << "static const char* const kDriverPredicates[] = {\n";
+    for (const auto& d : drvOrd) {
+        if (d.predicate.empty()) out << "    nullptr,\n";
+        else out << "    \"" << cStringEscape(d.predicate) << "\",\n";
+    }
+    out << "};\n";
+    out << "static const int kDriverStart[] = {";
+    for (int i = 0; i < N; ++i) { if (i) out << ", "; out << drvStart[i]; }
+    out << "};\n\n";
+
+    std::vector<int> connCnt(N, 0), connStart(N, 0);
+    for (const auto& connection : connections) {
+        if (connection.portIdx >= 0 && connection.portIdx < N)
+            ++connCnt[connection.portIdx];
+    }
+    pos = 0;
+    for (int i = 0; i < N; ++i) {
+        connStart[i] = pos;
+        pos += connCnt[i];
+    }
+    std::vector<PortConnectionInfo> connOrd(connections.size());
+    std::vector<int> connFill = connStart;
+    for (const auto& connection : connections) {
+        if (connection.portIdx >= 0 && connection.portIdx < N)
+            connOrd[connFill[connection.portIdx]++] = connection;
+    }
+    out << "static const XddPortConnectionRec kPortConnections[] = {\n";
+    for (const auto& connection : connOrd) {
+        out << "    {" << connection.portIdx << ", "
+            << connection.connectedIdx << ", \"" << connection.kind
+            << "\"},\n";
+    }
+    out << "};\n";
+    out << "static const int kPortConnectionCount = " << connOrd.size() << ";\n";
+    out << "static const int kPortConnectionStart[] = {";
+    for (int i = 0; i < N; ++i) {
+        if (i) out << ", ";
+        out << connStart[i];
+    }
+    out << "};\n\n";
+
+    // Load table
+    std::vector<int> ldCnt(N, 0), ldStart(N, 0);
+    for (const auto& l : loads)
+        if (l.targetIdx >= 0 && l.targetIdx < N) ++ldCnt[l.targetIdx];
+    pos = 0;
+    for (int i = 0; i < N; ++i) { ldStart[i] = pos; pos += ldCnt[i]; }
+    std::vector<LoadInfo> ldOrd(loads.size());
+    std::vector<int> ldFill = ldStart;
+    for (const auto& l : loads)
+        if (l.targetIdx >= 0 && l.targetIdx < N)
+            ldOrd[ldFill[l.targetIdx]++] = l;
+
+    out << "static const XddLoadRec kLoads[] = {\n";
+    for (const auto& l : ldOrd)
+        out << "    {" << l.targetIdx << ", " << l.consumerIdx << ", \""
+            << l.kind << "\", \"" << l.file << "\", " << l.line << "},\n";
+    out << "};\n";
+    out << "static const int kLoadCount = " << ldOrd.size() << ";\n";
+    out << "static const int kLoadStart[] = {";
+    for (int i = 0; i < N; ++i) { if (i) out << ", "; out << ldStart[i]; }
+    out << "};\n\n";
+
+    // API functions
+    out << R"(
+extern "C" {
+
+int xdd_abi_version(void) { return XDD_ABI_VERSION; }
+uint64_t xdd_capabilities(void) {
+    return XDD_CAP_SIGNAL_DIRECTION | XDD_CAP_PORT_CONNECTIONS
+           | XDD_CAP_DRIVER_DEPENDENCY_ROLE | XDD_CAP_DRIVER_PREDICATE;
+}
+
+XddDb* xdd_init(void) { return reinterpret_cast<XddDb*>(1); }
+void xdd_close(XddDb*) {}
+
+int xdd_signal_count(XddDb*) { return kSignalCount; }
+
+XddSignal xdd_resolve(XddDb*, const char* name) {
+    int lo = 0, hi = kNameIndexCount - 1;
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        int cmp = std::strcmp(name, kNameIndex[mid].name);
+        if (cmp == 0) return kNameIndex[mid].index;
+        if (cmp < 0) hi = mid - 1;
+        else lo = mid + 1;
+    }
+    return -1;
+}
+
+const char* xdd_signal_name(XddDb*, int idx) {
+    return (idx >= 0 && idx < kSignalCount) ? kSignals[idx].name : nullptr;
+}
+int xdd_signal_width(XddDb*, int idx) {
+    return (idx >= 0 && idx < kSignalCount) ? kSignals[idx].width : 0;
+}
+const char* xdd_signal_type(XddDb*, int idx) {
+    return (idx >= 0 && idx < kSignalCount) ? kSignals[idx].type : nullptr;
+}
+const char* xdd_signal_file(XddDb*, int idx) {
+    return (idx >= 0 && idx < kSignalCount) ? kSignals[idx].file : nullptr;
+}
+int xdd_signal_line(XddDb*, int idx) {
+    return (idx >= 0 && idx < kSignalCount) ? kSignals[idx].line : 0;
+}
+int xdd_signal_direction(XddDb*, int idx) {
+    return (idx >= 0 && idx < kSignalCount) ? kSignalDirections[idx] : 0;
+}
+
+int xdd_port_connection_count(XddDb*, int idx) {
+    if (idx < 0 || idx >= kSignalCount) return 0;
+    int e = (idx + 1 < kSignalCount) ? kPortConnectionStart[idx + 1]
+                                     : kPortConnectionCount;
+    return e - kPortConnectionStart[idx];
+}
+
+void xdd_port_connection(XddDb*, int idx, int i,
+                         int* connected_signal, const char** kind) {
+    *connected_signal = -1;
+    *kind = nullptr;
+    if (idx < 0 || idx >= kSignalCount) return;
+    int s = kPortConnectionStart[idx];
+    int e = (idx + 1 < kSignalCount) ? kPortConnectionStart[idx + 1]
+                                     : kPortConnectionCount;
+    if (i < 0 || i >= (e - s)) return;
+    const XddPortConnectionRec& connection = kPortConnections[s + i];
+    *connected_signal = connection.connected_signal;
+    *kind = connection.kind;
+}
+
+int xdd_trace_driver_count(XddDb*, int idx) {
+    if (idx < 0 || idx >= kSignalCount) return 0;
+    int e = (idx + 1 < kSignalCount) ? kDriverStart[idx + 1] : kDriverCount;
+    return e - kDriverStart[idx];
+}
+
+void xdd_trace_driver(XddDb*, int idx, int i,
+                      int* src_signal, const char** kind,
+                      const char** file, int* line) {
+    *src_signal = -1; *kind = nullptr; *file = nullptr; *line = 0;
+    if (idx < 0 || idx >= kSignalCount) return;
+    int s = kDriverStart[idx];
+    int e = (idx + 1 < kSignalCount) ? kDriverStart[idx + 1] : kDriverCount;
+    if (i < 0 || i >= (e - s)) return;
+    const XddDriverRec& d = kDrivers[s + i];
+    *src_signal = d.src_signal; *kind = d.kind; *file = d.file; *line = d.line;
+}
+
+const char* xdd_trace_driver_role(XddDb*, int idx, int i) {
+    if (idx < 0 || idx >= kSignalCount) return nullptr;
+    int s = kDriverStart[idx];
+    int e = (idx + 1 < kSignalCount) ? kDriverStart[idx + 1] : kDriverCount;
+    if (i < 0 || i >= (e - s)) return nullptr;
+    return kDrivers[s + i].role;
+}
+
+const char* xdd_trace_driver_predicate(XddDb*, int idx, int i) {
+    if (idx < 0 || idx >= kSignalCount) return nullptr;
+    int s = kDriverStart[idx];
+    int e = (idx + 1 < kSignalCount) ? kDriverStart[idx + 1] : kDriverCount;
+    if (i < 0 || i >= (e - s)) return nullptr;
+    return kDriverPredicates[s + i];
+}
+
+int xdd_trace_load_count(XddDb*, int idx) {
+    if (idx < 0 || idx >= kSignalCount) return 0;
+    int e = (idx + 1 < kSignalCount) ? kLoadStart[idx + 1] : kLoadCount;
+    return e - kLoadStart[idx];
+}
+
+void xdd_trace_load(XddDb*, int idx, int i,
+                    int* consumer, const char** kind,
+                    const char** file, int* line) {
+    *consumer = -1; *kind = nullptr; *file = nullptr; *line = 0;
+    if (idx < 0 || idx >= kSignalCount) return;
+    int s = kLoadStart[idx];
+    int e = (idx + 1 < kSignalCount) ? kLoadStart[idx + 1] : kLoadCount;
+    if (i < 0 || i >= (e - s)) return;
+    const XddLoadRec& l = kLoads[s + i];
+    *consumer = l.consumer; *kind = l.kind; *file = l.file; *line = l.line;
+}
+
+}  // extern "C"
+)";
+
+    V3Stats::addStat("DesignDb, signals", static_cast<double>(N));
+    V3Stats::addStat("DesignDb, drivers", static_cast<double>(drivers.size()));
+    V3Stats::addStat("DesignDb, loads", static_cast<double>(loads.size()));
+}
