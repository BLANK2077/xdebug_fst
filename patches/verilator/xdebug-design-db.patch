@@ -0,0 +1,172 @@
+// -*- mode: C++; c-file-style: "cc-mode" -*-
+//*************************************************************************
+// DESCRIPTION: Verilator: xdebug design database C API
+//
+// Code available from: https://verilator.org
+//
+//*************************************************************************
+//
+// This program is free software; you can redistribute it and/or modify it
+// under the terms of either the GNU Lesser General Public License Version 3
+// or the Perl Artistic License Version 2.0.
+// SPDX-FileCopyrightText: 2003-2026 Wilson Snyder
+// SPDX-License-Identifier: LGPL-3.0-only OR Artistic-2.0
+//
+//*************************************************************************
+//
+// Public C API for the xdebug design database generated by
+// Verilator --design-db.  The generated lib<top>__DesignDb.so exports
+// these functions.  xdebug loads the .so via dlopen() and calls them
+// to perform trace.driver / trace.load queries without NPI.
+//
+//*************************************************************************
+
+#ifndef VERILATOR_XDD_API_H_
+#define VERILATOR_XDD_API_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Opaque handle to the design database
+typedef struct XddDb XddDb;
+
+// Signal index (unsigned, -1 means not found)
+typedef int XddSignal;
+
+// ABI and optional capability discovery. Version 2 adds declared signal
+// direction and precomputed cross-hierarchy port connections while preserving
+// every version-1 function signature.
+#define XDD_ABI_VERSION 2
+#define XDD_CAP_SIGNAL_DIRECTION (UINT64_C(1) << 0)
+#define XDD_CAP_PORT_CONNECTIONS (UINT64_C(1) << 1)
+#define XDD_CAP_DRIVER_DEPENDENCY_ROLE (UINT64_C(1) << 2)
+#define XDD_CAP_DRIVER_PREDICATE (UINT64_C(1) << 3)
+
+// Signal type constants
+#define XDD_PORT 0
+#define XDD_REG  1
+#define XDD_WIRE 2
+
+// Signal metadata (generated in the static table)
+typedef struct {
+    const char* name;    // Hierarchical path, e.g. "top.u.ready"
+    const char* type;    // "port", "reg", "wire"
+    int         width;   // Bit width
+    const char* file;    // Source file
+    int         line;    // Source line
+} XddSignalInfo;
+
+// Name index entry (for binary search)
+typedef struct {
+    const char* name;
+    int         index;
+} XddNameEntry;
+
+// Driver record
+typedef struct {
+    int         target;      // Signal being driven
+    int         src_signal;  // Source signal on RHS (-1 = statement-only)
+    const char* kind;        // "proc_assign", "cont_assign", "nba", "force"
+    const char* role;        // rhs/self_rhs/control/statement or event_* dependency
+    const char* file;
+    int         line;
+} XddDriverRec;
+
+// Load record
+typedef struct {
+    int         target;      // Signal being consumed
+    int         consumer;    // Signal whose RHS consumes target
+    const char* kind;
+    const char* file;
+    int         line;
+} XddLoadRec;
+
+typedef struct {
+    int         port_signal;
+    int         connected_signal;
+    const char* kind;
+} XddPortConnectionRec;
+
+// ---- Lifecycle ----
+
+int      xdd_abi_version(void);
+uint64_t xdd_capabilities(void);
+
+// Initialize the design database.  Returns a non-null handle on success.
+XddDb* xdd_init(void);
+
+// Release all resources.
+void xdd_close(XddDb* db);
+
+// ---- Signal Resolution ----
+
+// Return the total number of signals in the design.
+int xdd_signal_count(XddDb* db);
+
+// Resolve a hierarchical signal name.  Returns the signal index, or -1.
+XddSignal xdd_resolve(XddDb* db, const char* name);
+
+// ---- Signal Metadata ----
+
+const char* xdd_signal_name(XddDb* db, XddSignal idx);
+const char* xdd_signal_type(XddDb* db, XddSignal idx);
+int         xdd_signal_width(XddDb* db, XddSignal idx);
+const char* xdd_signal_file(XddDb* db, XddSignal idx);
+int         xdd_signal_line(XddDb* db, XddSignal idx);
+
+// Direction constants: 0=unknown/non-port, 1=input, 2=output, 3=inout/ref.
+int xdd_signal_direction(XddDb* db, XddSignal idx);
+
+// ---- Cross-hierarchy port connections ----
+
+int xdd_port_connection_count(XddDb* db, XddSignal port_idx);
+void xdd_port_connection(XddDb* db, XddSignal port_idx, int i,
+                         int* connected_signal, const char** kind);
+
+// ---- Driver Tracing ----
+
+// Number of driver entries for a signal.
+int xdd_trace_driver_count(XddDb* db, XddSignal idx);
+
+// Get the i-th driver entry (0 <= i < count).
+// On return:
+//   *src_signal  = index of source signal on RHS (-1 = statement-only)
+//   *kind        = assignment kind string
+//   *file        = source file path
+//   *line        = source line number
+void xdd_trace_driver(XddDb* db, XddSignal idx, int i,
+                      int* src_signal, const char** kind,
+                      const char** file, int* line);
+
+// Return the semantic dependency role for the i-th driver entry.  Event roles
+// self_rhs identifies an exact target-to-itself RHS leaf and is not an upstream
+// data dependency. Event roles are event_posedge, event_negedge, event_bothedge,
+// or event_changed and name a
+// direct sensitivity signal for the containing procedural statement.
+const char* xdd_trace_driver_role(XddDb* db, XddSignal idx, int i);
+
+// Return the normalized activation predicate for the i-th driver entry, or
+// null when the source construct cannot be represented exactly. Signal
+// references use the same hierarchical paths accepted by xdd_resolve. The
+// internal ==?z and ==?x operators preserve casez and casex matching,
+// respectively; they are not interchangeable with ordinary equality.
+const char* xdd_trace_driver_predicate(XddDb* db, XddSignal idx, int i);
+
+// ---- Load Tracing ----
+
+// Number of load entries for a signal.
+int xdd_trace_load_count(XddDb* db, XddSignal idx);
+
+// Get the i-th load entry.
+void xdd_trace_load(XddDb* db, XddSignal idx, int i,
+                    int* consumer_signal, const char** kind,
+                    const char** file, int* line);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // Guard
