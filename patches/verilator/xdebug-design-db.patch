+// DESCRIPTION: Verilator: Test case matches with packed assignment patterns
+//
+// This file ONLY is placed under the Creative Commons Public Domain.
+// SPDX-FileCopyrightText: 2026 Wilson Snyder
+// SPDX-License-Identifier: CC0-1.0
+
+module t;
+  typedef struct packed {
+    logic [1:0] tag;
+    logic [3:0] payload;
+  } packet_t;
+
+  function automatic logic [7:0] decode(input packet_t packet);
+    case (packet) matches
+      '{2'b01, 4'ha}: decode = 8'h1a;
+      '{tag: 2'b10, payload: 4'h5}: decode = 8'h25;
+      default: decode = 8'hff;
+    endcase
+  endfunction
+
+  initial begin
+    if (decode(packet_t'(6'h1a)) !== 8'h1a) $stop;
+    if (decode(packet_t'(6'h25)) !== 8'h25) $stop;
+    if (decode(packet_t'(6'h3f)) !== 8'hff) $stop;
+    $write("*-* All Finished *-*\n");
+    $finish;
+  end
+endmodule
